{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zenodex.local/schemas/fire-cert-rules-v0.1-sha256.json",
  "title": "FIRE-Cert Proof Rule Certificate Schema Draft v0.1",
  "type": "object",
  "required": [
    "version",
    "object_hash",
    "instance_hash",
    "certificate_sha256",
    "dependency_hashes",
    "claims",
    "proof_tree"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "FIRE_CERT_RULES_v0.1"
    },
    "object_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "instance_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "certificate_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_certificate_summary": {
      "type": "object",
      "required": [
        "root_rule",
        "root_interval",
        "node_count",
        "exact_params",
        "source_bounds",
        "operator_tree"
      ],
      "properties": {
        "root_rule": {"type": "string", "minLength": 1},
        "root_interval": {
          "type": "object",
          "required": ["lower", "upper"],
          "properties": {
            "lower": {"type": "integer"},
            "upper": {"type": "integer"}
          },
          "additionalProperties": false
        },
        "node_count": {"type": "integer", "minimum": 1},
        "exact_params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "value": {"type": "integer"}
            },
            "additionalProperties": false
          }
        },
        "source_bounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "lower", "upper"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "lower": {"type": "integer"},
              "upper": {"type": "integer"}
            },
            "additionalProperties": false
          }
        },
        "operator_tree": {
          "$ref": "#/$defs/runtime_operator_node"
        }
      },
      "additionalProperties": false
    },
    "dependency_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "hash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_floor": {
      "type": "string",
      "enum": ["proved", "contract", "implemented", "tested_discovery", "hypothesis"]
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["evidence", "claim", "root_node"],
        "properties": {
          "evidence": {
            "type": "string",
            "enum": ["proved", "contract", "implemented", "tested_discovery", "hypothesis"]
          },
          "claim": {"type": "string", "minLength": 1},
          "root_node": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "proof_tree": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/proof_node"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "runtime_operator_node": {
      "type": "object",
      "required": ["rule", "lower", "upper", "children"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "lower": {"type": "integer"},
        "upper": {"type": "integer"},
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "integer"},
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/runtime_operator_node"}
        }
      },
      "additionalProperties": false
    },
    "proof_node": {
      "type": "object",
      "required": ["id", "rule", "claim"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "claim": {
          "type": "object",
          "required": ["predicate"],
          "properties": {
            "predicate": {"type": "string", "minLength": 1},
            "expr": {"type": "string"},
            "lower": {"type": "string"},
            "upper": {"type": "string"},
            "type": {"type": "string"},
            "dimension": {"type": "string"},
            "evidence": {
              "type": "string",
              "enum": ["proved", "contract", "implemented", "tested_discovery", "hypothesis"]
            },
            "asset": {"type": "string"},
            "party": {"type": "string"}
          },
          "additionalProperties": true
        },
        "preconditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence": {
          "type": "string",
          "enum": ["proved", "contract", "implemented", "tested_discovery", "hypothesis"]
        }
      },
      "additionalProperties": false
    }
  }
}
