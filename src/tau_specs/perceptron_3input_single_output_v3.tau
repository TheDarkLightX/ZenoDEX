# Tau-only 3-input perceptron experiment
#
# This is the next practical external-weight increment after the internal-learning
# and temporal-trace attempts exceeded the current Tau REPL budget.
#
# Model:
#   activation = (x1*w1) + (x2*w2) + (x3*w3) + bias
#   class = step(activation >= threshold)
#
# Domain restriction:
# - x1,x2,x3,w1,w2,w3,bias,threshold are bounded to 0..127
# - activation stays within bv[16] without wraparound
#
# Inputs:
# i1 = x1
# i2 = x2
# i3 = x3
# i4 = w1
# i5 = w2
# i6 = w3
# i7 = bias
# i8 = threshold
# i9 = class_claimed (sbf)
#
# Outputs:
# o1 = perceptron_3input_ok

set charvar off

always (o1[t]:sbf = 1:sbf <-> ((i1[t]:bv[16] <= { #x007F }:bv[16]) && (i2[t]:bv[16] <= { #x007F }:bv[16]) && (i3[t]:bv[16] <= { #x007F }:bv[16]) && (i4[t]:bv[16] <= { #x007F }:bv[16]) && (i5[t]:bv[16] <= { #x007F }:bv[16]) && (i6[t]:bv[16] <= { #x007F }:bv[16]) && (i7[t]:bv[16] <= { #x007F }:bv[16]) && (i8[t]:bv[16] <= { #x007F }:bv[16]) && ((((i1[t]:bv[16] * i4[t]:bv[16]) + (i2[t]:bv[16] * i5[t]:bv[16]) + (i3[t]:bv[16] * i6[t]:bv[16]) + i7[t]:bv[16]) >= i8[t]:bv[16] && i9[t]:sbf = 1:sbf) || (((i1[t]:bv[16] * i4[t]:bv[16]) + (i2[t]:bv[16] * i5[t]:bv[16]) + (i3[t]:bv[16] * i6[t]:bv[16]) + i7[t]:bv[16]) < i8[t]:bv[16] && i9[t]:sbf = 0:sbf)))).
