# zUSD Oracle Commit Guard v1
set charvar off
price_pos(p : bv[32]) := p > { #x00000000 }:bv[32].
pending_order_ok(active_p : bv[32], pending_p : bv[32]) := price_pos(active_p) && price_pos(pending_p) && (pending_p <= active_p).
freshness_ok(oracle_seen : sbf, fresh_ok : sbf) := (oracle_seen = 1:sbf) && (fresh_ok = 1:sbf).
vault_ok(auth_ok : sbf, mcr_ok : sbf) := (auth_ok = 1:sbf) && (mcr_ok = 1:sbf).
oracle_commit_ok(oracle_seen : sbf, auth_ok : sbf, active_p : bv[32], pending_p : bv[32], fresh_ok : sbf, mcr_ok : sbf) := pending_order_ok(active_p, pending_p) && freshness_ok(oracle_seen, fresh_ok) && vault_ok(auth_ok, mcr_ok).
always (o1[t]:sbf = 1:sbf <-> pending_order_ok(i3[t]:bv[32], i4[t]:bv[32])) && (o2[t]:sbf = 1:sbf <-> freshness_ok(i1[t]:sbf, i5[t]:sbf)) && (o3[t]:sbf = 1:sbf <-> vault_ok(i2[t]:sbf, i6[t]:sbf)) && (o4[t]:sbf = 1:sbf <-> oracle_commit_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:bv[32], i4[t]:bv[32], i5[t]:sbf, i6[t]:sbf)).
