      (i7[t]:sbf = 1:sbf) &&
      (i8[t]:sbf = 1:sbf) &&
      (i9[t]:sbf = 1:sbf) &&
      (i10[t]:sbf = 1:sbf) &&
      (i11[t]:sbf = 1:sbf) &&
      (i12[t]:sbf = 1:sbf) &&
      (i13[t]:sbf = 1:sbf) &&
      (i14[t]:sbf = 1:sbf) &&
      (i15[t]:sbf = 1:sbf) &&
      (i16[t]:sbf = 1:sbf) &&
      (i17[t]:sbf = 1:sbf) &&
      (i18[t]:sbf = 1:sbf) &&
      (i19[t]:sbf = 1:sbf)
    )
  ) &&
  (
    o3[t]:sbf = 1:sbf <->
    (
      (i1[t]:sbf = 0:sbf) ||
