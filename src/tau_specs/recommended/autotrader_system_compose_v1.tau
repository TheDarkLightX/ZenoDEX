set charvar off

always
  (
    o1[t]:sbf = 1:sbf <->
    (
        (i2[t]:sbf = 1:sbf) &&
        (i3[t]:sbf = 1:sbf) &&
        (i4[t]:sbf = 1:sbf) &&
        (i5[t]:sbf = 1:sbf) &&
        (i6[t]:sbf = 1:sbf) &&
