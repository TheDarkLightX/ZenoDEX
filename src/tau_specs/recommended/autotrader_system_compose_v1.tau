        (i14[t]:sbf = 1:sbf) &&
        (i15[t]:sbf = 1:sbf) &&
        (i16[t]:sbf = 1:sbf) &&
        (i17[t]:sbf = 1:sbf) &&
        (i18[t]:sbf = 1:sbf) &&
        (i19[t]:sbf = 1:sbf)
      )
  ) &&
  (
    o2[t]:sbf = 1:sbf <->
    (
      (i1[t]:sbf = 1:sbf) &&
      (i2[t]:sbf = 1:sbf) &&
      (i3[t]:sbf = 1:sbf) &&
