# AutoTrader Emit Finalize v1
#
# PURPOSE: Final compose for the live auto-trader emit path.
#
# i1 = emit_requested
# i2 = system_compose_ok
# i3 = submit_bundle_ok
# o1 = emit_finalize_ok

set charvar off

always
  (
    o1[t]:sbf = 1:sbf <->
    (
      (i1[t]:sbf = 0:sbf) ||
      ((i2[t]:sbf = 1:sbf) && (i3[t]:sbf = 1:sbf))
    )
  ).
