# Create Pool Apply (proof-gated, v1) - Pool Initialization Transition (DEX)
#
# Purpose: a Tau-executable apply-step gate compatible with host-side verified computation.
# - Tau enforces structural constraints for pool creation.
# - Host/verifier supplies `proof_ok` and `binding_ok` (fail-closed flags).
#
# This spec intentionally does NOT validate pool_id hashing or LP mint sqrt math in Tau.
#
# Stream mapping:
# i1 = reserve0_before (bv[32])    # expected 0
# i2 = reserve1_before (bv[32])    # expected 0
# i3 = lp_supply_before (bv[32])   # expected 0
# i4 = amount0_in (bv[32])
# i5 = amount1_in (bv[32])
# i6 = fee_bps (bv[32])
# i7 = lp_minted (bv[32])          # externally computed
# i8 = reserve0_after (bv[32])
# i9 = reserve1_after (bv[32])
# i10 = lp_supply_after (bv[32])   # expected lp_minted + MIN_LP_LOCK
# i11 = proof_ok (sbf)
# i12 = binding_ok (sbf)
# o1 = create_pool_apply_ok

set charvar off

min_lp_lock() := { #x000003E8 }:bv[32].  # 1000

always (o1[t]:sbf = 1:sbf <->
  ((i11[t]:sbf = 1:sbf) &&
   (i12[t]:sbf = 1:sbf) &&
   (i1[t]:bv[32] = { #x00000000 }:bv[32]) &&
   (i2[t]:bv[32] = { #x00000000 }:bv[32]) &&
   (i3[t]:bv[32] = { #x00000000 }:bv[32]) &&
   (i4[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i5[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i6[t]:bv[32] <= { #x00002710 }:bv[32]) &&
   (i7[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i8[t]:bv[32] = i4[t]:bv[32]) &&
   (i9[t]:bv[32] = i5[t]:bv[32]) &&
   (i10[t]:bv[32] = i7[t]:bv[32] + min_lp_lock()) &&
   (i10[t]:bv[32] > min_lp_lock()))).
