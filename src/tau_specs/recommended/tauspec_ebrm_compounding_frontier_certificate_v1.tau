# TauSpecEBRM Compounding Frontier Certificate v1
#
# PURPOSE:
#   Guard a host-computed TauSpecEBRM frontier-ranking certificate. The host
#   builds the bounded candidate pool, ranks it against deterministic baselines,
#   checks AB/CoW and compounding-target coverage, replays Tau traces, and binds
#   advisory/no-authority facts. Tau only combines projected facts.
#
# Stream mapping:
# i1  = selector_active
# i2  = candidate_pool_bound_ok
# i3  = tau_traces_passed
# i4  = invalid_accepts_zero
# i5  = topk_not_worse_than_baselines
# i6  = work_item_1_ab_covered
# i7  = work_item_2_cow_covered
# i8  = deterministic_replay_ok
# i9  = advisory_model_only
# i10 = performance_profile_bound_ok
# i11 = no_authority_effect
# o1  = replay_evidence_ok
# o2  = frontier_coverage_ok
# o3  = performance_replay_ok
# o4  = authority_boundary_ok
# o5  = compounding_frontier_certificate_ok
# o6  = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
replay_evidence_ok(pool : sbf, tau : sbf, invalid_zero : sbf) := is1(pool) && is1(tau) && is1(invalid_zero).
frontier_coverage_ok(topk : sbf, ab : sbf, cow : sbf) := is1(topk) && is1(ab) && is1(cow).
performance_replay_ok(deterministic : sbf, perf : sbf) := is1(deterministic) && is1(perf).
authority_boundary_ok(advisory : sbf, no_authority : sbf) := is1(advisory) && is1(no_authority).
certificate_ok(active : sbf, pool : sbf, tau : sbf, invalid_zero : sbf, topk : sbf, ab : sbf, cow : sbf, deterministic : sbf, advisory : sbf, perf : sbf, no_authority : sbf) := is1(active) && replay_evidence_ok(pool, tau, invalid_zero) && frontier_coverage_ok(topk, ab, cow) && performance_replay_ok(deterministic, perf) && authority_boundary_ok(advisory, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> replay_evidence_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> frontier_coverage_ok(i5[t]:sbf, i6[t]:sbf, i7[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> performance_replay_ok(i8[t]:sbf, i10[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> authority_boundary_ok(i9[t]:sbf, i11[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i11[t]:sbf))).
