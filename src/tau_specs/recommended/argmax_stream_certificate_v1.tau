# Argmax Stream Certificate v1 - Canonical (Key,Index) Winner Check (DEX)
#
# MUTABILITY: IMMUTABLE
# UPDATABLE_PARAMS: none
# IMMUTABLE_INVARIANTS:
#   winner >= candidate under lexicographic order on (key desc, index asc)
#
# PURPOSE: Verify a proof-carrying "winner is canonical" certificate for a large
# candidate set where the expensive scoring is done off-chain (optionally on GPU)
# and Tau only checks a cheap, deterministic certificate shape.
#
# How to use:
# - Compute per-candidate (key, index) in Python (CPU/GPU).
# - Pick winner = argmax under lex order: (key desc, index asc).
# - Emit one Tau step per candidate containing the winner pair and the candidate pair.
# - Tau checks: winner >= candidate for every step.
#
# Stream mapping:
# i1 = winner_key (bv[64])
# i2 = winner_index (bv[32])
# i3 = cand_key (bv[64])
# i4 = cand_index (bv[32])
# i5 = binding_ok (sbf)           # host asserts key binding/scoring correctness
# o1 = argmax_cert_ok

set charvar off

ge_pair(wk : bv[64], wi : bv[32], ck : bv[64], ci : bv[32]) := (wk > ck) || ((wk = ck) && (wi <= ci)).

always (o1[t]:sbf = 1:sbf <-> ((i5[t]:sbf = 1:sbf) && ge_pair(i1[t]:bv[64], i2[t]:bv[32], i3[t]:bv[64], i4[t]:bv[32]))).

