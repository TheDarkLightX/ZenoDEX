# evidence_dag_hitting_set_certificate_v1.tau
#
# PURPOSE:
#   Admit a host-recomputed evidence-DAG hitting-set research certificate.
#   The host extracts a bounded public-claim blocker graph, checks dependency
#   acyclicity, computes the exact minimum evidence-task bundle for the bounded
#   blocker set, and runs negative cases for cycles, missing paths, and
#   non-minimal bundles. Tau only composes those boolean facts. It has no
#   settlement, oracle, liquidation, production-promotion, or state-root
#   authority.
#
# Stream mapping:
# i1  = certificate_active
# i2  = graph_bounded_ok
# i3  = acyclic_ok
# i4  = every_claim_has_path_ok
# i5  = blocker_cover_ok
# i6  = objective_minimal_ok
# i7  = deterministic_tie_ok
# i8  = quality_floor_ok
# i9  = redundancy_pruned_ok
# i10 = synthetic_cycle_reject_ok
# i11 = missing_path_reject_ok
# i12 = nonminimal_bundle_reject_ok
# i13 = resource_budget_ok
# i14 = advisory_only
# i15 = no_authority_effect
#
# o1 = graph_integrity_ok
# o2 = minimal_cover_certificate_ok
# o3 = refutation_suite_ok
# o4 = authority_boundary_ok
# o5 = evidence_dag_hitting_set_certificate_ok
# o6 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
graph_integrity_ok(bounded : sbf, acyclic : sbf, claim_paths : sbf) := is1(bounded) && is1(acyclic) && is1(claim_paths).
minimal_cover_certificate_ok(blocker_cover : sbf, objective_minimal : sbf, deterministic_tie : sbf, quality_floor : sbf, redundancy_pruned : sbf) := is1(blocker_cover) && is1(objective_minimal) && is1(deterministic_tie) && is1(quality_floor) && is1(redundancy_pruned).
refutation_suite_ok(cycle_reject : sbf, missing_path_reject : sbf, nonminimal_reject : sbf) := is1(cycle_reject) && is1(missing_path_reject) && is1(nonminimal_reject).
authority_boundary_ok(resource_budget : sbf, advisory_only : sbf, no_authority : sbf) := is1(resource_budget) && is1(advisory_only) && is1(no_authority).
certificate_ok(active : sbf, bounded : sbf, acyclic : sbf, claim_paths : sbf, blocker_cover : sbf, objective_minimal : sbf, deterministic_tie : sbf, quality_floor : sbf, redundancy_pruned : sbf, cycle_reject : sbf, missing_path_reject : sbf, nonminimal_reject : sbf, resource_budget : sbf, advisory_only : sbf, no_authority : sbf) := is1(active) && graph_integrity_ok(bounded, acyclic, claim_paths) && minimal_cover_certificate_ok(blocker_cover, objective_minimal, deterministic_tie, quality_floor, redundancy_pruned) && refutation_suite_ok(cycle_reject, missing_path_reject, nonminimal_reject) && authority_boundary_ok(resource_budget, advisory_only, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> graph_integrity_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> minimal_cover_certificate_ok(i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> refutation_suite_ok(i10[t]:sbf, i11[t]:sbf, i12[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> authority_boundary_ok(i13[t]:sbf, i14[t]:sbf, i15[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf, i15[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i15[t]:sbf))).
