# Runtime Action Capability Envelope v1
#
# PURPOSE:
# Gate runtime/API actions with host-projected one-hot action decode,
# capability subset, caller/session authentication, replay-frontier facts, and
# policy binding. Unknown or mixed actions fail closed at the decode fact.
#
# i1  = action_requested (sbf)
# i2  = action_one_hot_ok (sbf)
# i3  = action_kind_allowed (sbf)
# i4  = requested_capability_mask_bound (sbf)
# i5  = capability_subset_ok (sbf)
# i6  = caller_authenticated (sbf)
# i7  = session_current (sbf)
# i8  = nonce_fresh (sbf)
# i9  = idempotency_clear (sbf)
# i10 = resource_binding_ok (sbf)
# i11 = policy_epoch_current (sbf)
# i12 = proof_ok (sbf)
# i13 = binding_ok (sbf)
#
# o1 = action_decode_ok
# o2 = capability_scope_ok
# o3 = replay_frontier_ok
# o4 = runtime_context_ok
# o5 = action_admissible
# o6 = proof_gated_action_admissible

set charvar off

always
  (o1[t]:sbf = 1:sbf <-> ((i2[t]:sbf = 1:sbf) && (i3[t]:sbf = 1:sbf))) &&
  (o2[t]:sbf = 1:sbf <-> ((i4[t]:sbf = 1:sbf) && (i5[t]:sbf = 1:sbf))) &&
  (o3[t]:sbf = 1:sbf <-> ((i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf))) &&
  (o4[t]:sbf = 1:sbf <-> ((i6[t]:sbf = 1:sbf) && (i7[t]:sbf = 1:sbf) && (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf))) &&
  (o5[t]:sbf = 1:sbf <-> ((i1[t]:sbf = 1:sbf) && (i2[t]:sbf = 1:sbf) && (i3[t]:sbf = 1:sbf) && (i4[t]:sbf = 1:sbf) && (i5[t]:sbf = 1:sbf) && (i6[t]:sbf = 1:sbf) && (i7[t]:sbf = 1:sbf) && (i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf) && (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf))) &&
  (o6[t]:sbf = 1:sbf <-> ((i1[t]:sbf = 1:sbf) && (i2[t]:sbf = 1:sbf) && (i3[t]:sbf = 1:sbf) && (i4[t]:sbf = 1:sbf) && (i5[t]:sbf = 1:sbf) && (i6[t]:sbf = 1:sbf) && (i7[t]:sbf = 1:sbf) && (i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf) && (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf) && (i13[t]:sbf = 1:sbf))).
