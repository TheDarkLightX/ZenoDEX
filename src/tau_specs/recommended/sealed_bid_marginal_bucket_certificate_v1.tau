# sealed_bid_marginal_bucket_certificate_v1.tau
#
# PURPOSE:
#   Admit a host-recomputed research certificate for an oversubscribed sealed-bid
#   marginal price bucket. The host checks largest-remainder apportionment,
#   settlement parity, receipt privacy, and split-bid risk classification.
#   Tau only composes those proof facts and has no settlement authority.
#
# Stream mapping:
# i1  = certificate_active
# i2  = marginal_bucket_present
# i3  = settlement_parity_ok
# i4  = lower_upper_quota_ok
# i5  = largest_remainder_tie_order_ok
# i6  = public_receipts_hide_private_fields
# i7  = occurrence_index_tie_scope_ok
# i8  = split_bid_risk_classified
# i9  = single_bidder_scope_ok
# i10 = resource_budget_ok
# i11 = no_settlement_authority
#
# o1 = apportionment_math_ok
# o2 = privacy_boundary_ok
# o3 = research_certificate_ok
# o4 = production_scope_candidate_ok
# o5 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
apportionment_math_ok(bucket : sbf, parity : sbf, quota : sbf, tie : sbf, occurrence : sbf, budget : sbf) := is1(bucket) && is1(parity) && is1(quota) && is1(tie) && is1(occurrence) && is1(budget).
privacy_boundary_ok(receipts_private : sbf, no_authority : sbf) := is1(receipts_private) && is1(no_authority).
research_certificate_ok(active : sbf, bucket : sbf, parity : sbf, quota : sbf, tie : sbf, receipts_private : sbf, occurrence : sbf, risk_classified : sbf, budget : sbf, no_authority : sbf) := is1(active) && apportionment_math_ok(bucket, parity, quota, tie, occurrence, budget) && privacy_boundary_ok(receipts_private, no_authority) && is1(risk_classified).
production_scope_candidate_ok(active : sbf, bucket : sbf, parity : sbf, quota : sbf, tie : sbf, receipts_private : sbf, occurrence : sbf, risk_classified : sbf, single_bidder_scope : sbf, budget : sbf, no_authority : sbf) := research_certificate_ok(active, bucket, parity, quota, tie, receipts_private, occurrence, risk_classified, budget, no_authority) && is1(single_bidder_scope).

always (o1[t]:sbf = 1:sbf <-> apportionment_math_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i7[t]:sbf, i10[t]:sbf)) && (o2[t]:sbf = 1:sbf <-> privacy_boundary_ok(i6[t]:sbf, i11[t]:sbf)) && (o3[t]:sbf = 1:sbf <-> research_certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i10[t]:sbf, i11[t]:sbf)) && (o4[t]:sbf = 1:sbf <-> production_scope_candidate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf)) && (o5[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i11[t]:sbf))).
