# CATEGORY: replay-protection / bounded nonce window
# CLAIM: admit a nonce-use request only when the same channel was quiet for the previous two steps.
#
# Stream mapping:
#   i1 = nonce-use requested
#   o1 = admitted fresh use
#
# Contract:
#   o1[t] = i1[t] & ~i1[t-1] & ~i1[t-2]
#
# This is a bounded-history replay frontier. The first two output rows are
# fail-closed warm-up rows because the full two-step prior window has not yet
# been observed.
set charvar off

always
  (o1[t]:sbf = (i1[t]:sbf & (i1[t-1]:sbf)' & (i1[t-2]:sbf)')).
end
