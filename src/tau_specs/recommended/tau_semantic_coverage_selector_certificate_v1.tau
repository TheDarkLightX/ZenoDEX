# tau_semantic_coverage_selector_certificate_v1.tau
#
# PURPOSE:
#   Admit a replayed semantic-coverage frontier certificate. The host builds the
#   active Tau inventory, ranks semantic-contract gaps, binds AB-ordering and
#   CoW-matching work items, replays the proposed Tau certificates, and emits a
#   report. Tau composes those facts into an advisory no-authority certificate.
#
# Stream mapping:
# i1  = selector_active
# i2  = active_inventory_built
# i3  = semantic_refinement_queue_built
# i4  = coverage_gaps_present
# i5  = critical_bucket_coverage_ok
# i6  = work_item_1_ab_selected
# i7  = work_item_2_cow_selected
# i8  = proposed_spec_artifacts_present
# i9  = mutation_atlas_dependency_bound
# i10 = deterministic_priority_order_ok
# i11 = semantic_contract_next_actions_bound
# i12 = tau_replay_invalid_accepts_zero
# i13 = advisory_selection_only
# i14 = no_runtime_authority_effect
# i15 = budget_profile_ok
#
# o1 = inventory_frontier_ok
# o2 = work_item_specs_ok
# o3 = replay_and_order_ok
# o4 = authority_boundary_ok
# o5 = semantic_coverage_selector_certificate_ok
# o6 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
inventory_frontier_ok(inventory_ok : sbf, queue_ok : sbf, gaps_ok : sbf, bucket_ok : sbf) := is1(inventory_ok) && is1(queue_ok) && is1(gaps_ok) && is1(bucket_ok).
work_item_specs_ok(ab_ok : sbf, cow_ok : sbf, artifacts_ok : sbf, dependency_ok : sbf) := is1(ab_ok) && is1(cow_ok) && is1(artifacts_ok) && is1(dependency_ok).
replay_and_order_ok(order_ok : sbf, next_actions_ok : sbf, invalid_accepts_zero : sbf, budget_ok : sbf) := is1(order_ok) && is1(next_actions_ok) && is1(invalid_accepts_zero) && is1(budget_ok).
authority_boundary_ok(advisory_only : sbf, no_authority : sbf) := is1(advisory_only) && is1(no_authority).
certificate_ok(active : sbf, inventory_ok : sbf, queue_ok : sbf, gaps_ok : sbf, bucket_ok : sbf, ab_ok : sbf, cow_ok : sbf, artifacts_ok : sbf, dependency_ok : sbf, order_ok : sbf, next_actions_ok : sbf, invalid_accepts_zero : sbf, advisory_only : sbf, no_authority : sbf, budget_ok : sbf) := is1(active) && inventory_frontier_ok(inventory_ok, queue_ok, gaps_ok, bucket_ok) && work_item_specs_ok(ab_ok, cow_ok, artifacts_ok, dependency_ok) && replay_and_order_ok(order_ok, next_actions_ok, invalid_accepts_zero, budget_ok) && authority_boundary_ok(advisory_only, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> inventory_frontier_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> work_item_specs_ok(i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> replay_and_order_ok(i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i15[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> authority_boundary_ok(i13[t]:sbf, i14[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf, i15[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i14[t]:sbf))).
