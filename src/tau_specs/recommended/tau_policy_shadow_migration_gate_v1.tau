# Tau Policy Shadow Migration Gate v1
#
# PURPOSE:
# Admit a policy migration only when the old/runtime checker and shadow/latest
# checker agree on decisions, artifacts are bound, trace evidence is current,
# and a fallback policy is available.
#
# i1  = migration_step_requested (sbf)
# i2  = old_checker_decision (sbf)
# i3  = new_checker_decision (sbf)
# i4  = reason_class_match (sbf)
# i5  = new_outputs_parse_ok (sbf)
# i6  = spec_hash_bound (sbf)
# i7  = tau_binary_hash_bound (sbf)
# i8  = profile_allowed (sbf)
# i9  = trace_corpus_passed (sbf)
# i10 = fallback_policy_available (sbf)
# i11 = proof_ok (sbf)
# i12 = binding_ok (sbf)
#
# o1 = decision_equivalent
# o2 = artifact_binding_ok
# o3 = shadow_evidence_ok
# o4 = fallback_ready
# o5 = migration_admissible
# o6 = proof_gated_migration_admissible

set charvar off

decision_equivalent(old_checker_decision : sbf, new_checker_decision : sbf, reason_class_match : sbf) := (old_checker_decision = new_checker_decision) && (reason_class_match = 1:sbf).

artifact_binding_ok(spec_hash_bound : sbf, tau_binary_hash_bound : sbf, profile_allowed : sbf) := (spec_hash_bound = 1:sbf) && (tau_binary_hash_bound = 1:sbf) && (profile_allowed = 1:sbf).

shadow_evidence_ok(new_outputs_parse_ok : sbf, trace_corpus_passed : sbf) := (new_outputs_parse_ok = 1:sbf) && (trace_corpus_passed = 1:sbf).

always
  (o1[t]:sbf = 1:sbf <-> decision_equivalent(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> artifact_binding_ok(i6[t]:sbf, i7[t]:sbf, i8[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> shadow_evidence_ok(i5[t]:sbf, i9[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> (i10[t]:sbf = 1:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> ((i1[t]:sbf = 1:sbf) && decision_equivalent(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf) && artifact_binding_ok(i6[t]:sbf, i7[t]:sbf, i8[t]:sbf) && shadow_evidence_ok(i5[t]:sbf, i9[t]:sbf) && (i10[t]:sbf = 1:sbf))) &&
  (o6[t]:sbf = 1:sbf <-> ((i1[t]:sbf = 1:sbf) && decision_equivalent(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf) && artifact_binding_ok(i6[t]:sbf, i7[t]:sbf, i8[t]:sbf) && shadow_evidence_ok(i5[t]:sbf, i9[t]:sbf) && (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf))).
