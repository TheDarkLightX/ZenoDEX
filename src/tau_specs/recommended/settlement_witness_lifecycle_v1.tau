set charvar off

outcome_total(settled : sbf, rejected_with_reason : sbf) :=
  ((settled = 1:sbf) && !(rejected_with_reason = 1:sbf)) ||
  (!(settled = 1:sbf) && (rejected_with_reason = 1:sbf)).

witness_coherent(witness_present : sbf, witness_valid : sbf) :=
  (witness_valid = 1:sbf) -> (witness_present = 1:sbf).

settled_requires_witness(settled : sbf, witness_valid : sbf, end_to_end_packet_ok : sbf) :=
  (settled = 1:sbf) -> ((witness_valid = 1:sbf) && (end_to_end_packet_ok = 1:sbf)).

rejection_total(rejected_with_reason : sbf, rejection_reason_present : sbf) :=
  (rejected_with_reason = 1:sbf) -> (rejection_reason_present = 1:sbf).

lifecycle_progress(witness_valid : sbf, before_expiry : sbf, settled : sbf, rejected_with_reason : sbf) :=
  !((witness_valid = 1:sbf) && (before_expiry = 1:sbf)) ||
  (settled = 1:sbf) ||
  (rejected_with_reason = 1:sbf).

settlement_witness_lifecycle_ok(witness_present : sbf, witness_valid : sbf, before_expiry : sbf, end_to_end_packet_ok : sbf, settled : sbf, rejected_with_reason : sbf, rejection_reason_present : sbf) :=
  outcome_total(settled, rejected_with_reason) &&
  witness_coherent(witness_present, witness_valid) &&
  settled_requires_witness(settled, witness_valid, end_to_end_packet_ok) &&
  rejection_total(rejected_with_reason, rejection_reason_present) &&
  lifecycle_progress(witness_valid, before_expiry, settled, rejected_with_reason).

always
  (o1[t]:sbf = 1:sbf <-> outcome_total(i5[t]:sbf, i6[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> witness_coherent(i1[t]:sbf, i2[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> settled_requires_witness(i5[t]:sbf, i2[t]:sbf, i4[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> rejection_total(i6[t]:sbf, i7[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> lifecycle_progress(i2[t]:sbf, i3[t]:sbf, i5[t]:sbf, i6[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> settlement_witness_lifecycle_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf)).
