# TauSwap swap exact-out (proof-gated + fee-carrying, v1)
#
# Purpose: a Tau-executable gate compatible with host-side verified computation.
# - Tau enforces basic structural constraints and reserve transitions.
# - Host/verifier supplies `proof_ok`, `binding_ok`, and `fee_ok` (fail-closed flags).
#
# This spec intentionally does NOT validate the CPMM pricing formula or fee rounding math in Tau.
#
# Fee validation is decomposed into a separate kernel:
# - `src/tau_specs/recommended/swap_fee_total_ceil_v1.tau` validates `fee_total`
# - This spec only requires the resulting `fee_ok=1` and basic non-degeneracy (`fee_total < amount_in`).
#
# Stream mapping:
# i1 = reserve_in (bv[32])
# i2 = reserve_out (bv[32])
# i3 = amount_out (bv[32])
# i4 = fee_bps (bv[32])
# i5 = max_amount_in (bv[32])
# i6 = amount_in (bv[32])          # externally computed (gross_in)
# i7 = new_reserve_in (bv[32])
# i8 = new_reserve_out (bv[32])
# i9 = fee_total (bv[32])          # externally computed
# i10 = proof_ok (sbf)
# i11 = binding_ok (sbf)
# i12 = fee_ok (sbf)               # produced by swap_fee_total_ceil_v1 (or equivalent)
# o1 = swap_exact_out_fee_valid

set charvar off

always (o1[t]:sbf = 1:sbf <->
  ((i10[t]:sbf = 1:sbf) &&
   (i11[t]:sbf = 1:sbf) &&
   (i12[t]:sbf = 1:sbf) &&
   (i1[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i2[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i3[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i6[t]:bv[32] > { #x00000000 }:bv[32]) &&
   (i4[t]:bv[32] <= { #x00002710 }:bv[32]) &&
   (i3[t]:bv[32] < i2[t]:bv[32]) &&
   (i6[t]:bv[32] <= i5[t]:bv[32]) &&
   (i9[t]:bv[32] < i6[t]:bv[32]) &&
   (i7[t]:bv[32] = i1[t]:bv[32] + i6[t]:bv[32]) &&
   (i7[t]:bv[32] >= i1[t]:bv[32]) &&
   (i8[t]:bv[32] = i2[t]:bv[32] - i3[t]:bv[32]))).
