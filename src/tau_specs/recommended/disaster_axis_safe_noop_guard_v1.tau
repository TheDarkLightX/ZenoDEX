# Disaster Axis Safe No-op Guard v1
#
# PURPOSE:
# Require named disaster axes to either be absent for action admission or be
# absorbed as a safe no-op with unchanged state and no external effect.
#
# i1  = action_requested (sbf)
# i2  = axis_path_escape (sbf)
# i3  = axis_url_escape (sbf)
# i4  = axis_replay_duplicate (sbf)
# i5  = axis_nondeterministic_template (sbf)
# i6  = axis_oracle_equivocation (sbf)
# i7  = axis_overflow_or_range (sbf)
# i8  = safe_noop_emitted (sbf)
# i9  = state_root_unchanged (sbf)
# i10 = external_effect_absent (sbf)
# i11 = proof_ok (sbf)
# i12 = binding_ok (sbf)
#
# o1 = no_disaster_axis
# o2 = safe_noop_valid
# o3 = action_admissible
# o4 = containment_ok

set charvar off

no_disaster_axis(path_escape : sbf, url_escape : sbf, replay_duplicate : sbf, nondeterministic_template : sbf, oracle_equivocation : sbf, overflow_or_range : sbf) := (path_escape = 0:sbf) && (url_escape = 0:sbf) && (replay_duplicate = 0:sbf) && (nondeterministic_template = 0:sbf) && (oracle_equivocation = 0:sbf) && (overflow_or_range = 0:sbf).

safe_noop_valid(safe_noop_emitted : sbf, state_root_unchanged : sbf, external_effect_absent : sbf) := (safe_noop_emitted = 1:sbf) && (state_root_unchanged = 1:sbf) && (external_effect_absent = 1:sbf).

always
  (o1[t]:sbf = 1:sbf <-> no_disaster_axis(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> safe_noop_valid(i8[t]:sbf, i9[t]:sbf, i10[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> ((i1[t]:sbf = 1:sbf) && no_disaster_axis(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf) && (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf))) &&
  (o4[t]:sbf = 1:sbf <-> (no_disaster_axis(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf) || safe_noop_valid(i8[t]:sbf, i9[t]:sbf, i10[t]:sbf))).
