# AB Child-Frontier Transition-Group Compression Scope Certificate v1
#
# PURPOSE:
#   Admit a research-only certificate for the AB strict zero-min child-frontier
#   transition-group compression receipt. The host checks the compression JSON
#   report, source bidirectional report pins, compression counts, generated-group
#   coverage, digest pins, deterministic replay, mutation controls, case-row
#   pins, explicit non-claims, and no-authority rail. Tau only composes those
#   host facts into a fail-closed envelope.
#
# Stream mapping:
# i1  = certificate_active
# i2  = compression_report_ok
# i3  = n7_zero_min_scope_ok
# i4  = source_bidirectional_binding_ok
# i5  = compression_counts_ok
# i6  = generated_group_coverage_ok
# i7  = compression_digests_pinned
# i8  = deterministic_replay_ok
# i9  = negative_controls_reject
# i10 = case_rows_bound
# i11 = authority_boundary_ok
# i12 = no_authority_effect
# i13 = corpus_nonvacuous
# i14 = host_recomputation_nonclaim_bound
#
# o1 = scope_and_source_ok
# o2 = compression_measurement_ok
# o3 = group_coverage_ok
# o4 = replay_and_refutation_ok
# o5 = digest_and_case_pins_ok
# o6 = authority_boundary_ok
# o7 = transition_group_compression_certificate_ok
# o8 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
scope_and_source_ok(report_ok : sbf, n7_zero_min : sbf, source_binding : sbf, nonvacuous : sbf, host_recompute_nonclaim : sbf) := is1(report_ok) && is1(n7_zero_min) && is1(source_binding) && is1(nonvacuous) && is1(host_recompute_nonclaim).
compression_measurement_ok(compression_counts : sbf, case_rows : sbf) := is1(compression_counts) && is1(case_rows).
group_coverage_ok(group_coverage : sbf) := is1(group_coverage).
replay_and_refutation_ok(deterministic_replay : sbf, negative_controls : sbf) := is1(deterministic_replay) && is1(negative_controls).
digest_and_case_pins_ok(compression_digests : sbf, case_rows : sbf) := is1(compression_digests) && is1(case_rows).
authority_ok(boundary : sbf, no_authority : sbf) := is1(boundary) && is1(no_authority).
certificate_ok(active : sbf, report_ok : sbf, n7_zero_min : sbf, source_binding : sbf, compression_counts : sbf, group_coverage : sbf, compression_digests : sbf, deterministic_replay : sbf, negative_controls : sbf, case_rows : sbf, boundary : sbf, no_authority : sbf, nonvacuous : sbf, host_recompute_nonclaim : sbf) := is1(active) && scope_and_source_ok(report_ok, n7_zero_min, source_binding, nonvacuous, host_recompute_nonclaim) && compression_measurement_ok(compression_counts, case_rows) && group_coverage_ok(group_coverage) && replay_and_refutation_ok(deterministic_replay, negative_controls) && digest_and_case_pins_ok(compression_digests, case_rows) && authority_ok(boundary, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> scope_and_source_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i13[t]:sbf, i14[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> compression_measurement_ok(i5[t]:sbf, i10[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> group_coverage_ok(i6[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> replay_and_refutation_ok(i8[t]:sbf, i9[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> digest_and_case_pins_ok(i7[t]:sbf, i10[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> authority_ok(i11[t]:sbf, i12[t]:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf)) &&
  (o8[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i12[t]:sbf))).
