# M6 Substrate Disposition Gate v1
#
# Checks one proposed per-operation disposition using a previously verified,
# exact Tau-profile compatibility fact. It permits ZenoLedger continuity for
# Tau-independent operations and for Tau-native asset operations carrying a
# precommitted safe-exit proof. Other Tau-dependent operations require Tau.
#
# i1 = exact Tau profile usable
# i2/i3/i4 = operation is Tau-independent / Tau-dependent / Tau-native-asset
# i5 = portable Tau-computation certificate locally verified
# i6 = precommitted safe-exit and single-issuer proof for Tau-native assets
# i7/i8 = last adopted ZenoDEX semantics available / ZenoLedger state current
# i9/i10/i11 = proposed use-Tau / use-ZenoLedger / reject-or-pend
# i12 = operation requested
# i13/i14 = proof / binding accepted
# o1 = proposed disposition valid
# o2 = proposed disposition authorizes execution

set charvar off

always
  (o1[t]:sbf = 1:sbf <-> (
    (i12[t]:sbf = 1:sbf) && (i13[t]:sbf = 1:sbf) && (i14[t]:sbf = 1:sbf) &&
    (((i2[t]:sbf = 1:sbf) && (i3[t]:sbf = 0:sbf) && (i4[t]:sbf = 0:sbf)) ||
     ((i2[t]:sbf = 0:sbf) && (i3[t]:sbf = 1:sbf) && (i4[t]:sbf = 0:sbf)) ||
     ((i2[t]:sbf = 0:sbf) && (i3[t]:sbf = 0:sbf) && (i4[t]:sbf = 1:sbf))) &&
    (((i9[t]:sbf = 1:sbf) && (i10[t]:sbf = 0:sbf) && (i11[t]:sbf = 0:sbf) &&
      (i1[t]:sbf = 1:sbf)) ||
     ((i9[t]:sbf = 0:sbf) && (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 0:sbf) &&
      (i1[t]:sbf = 0:sbf) && (i7[t]:sbf = 1:sbf) && (i8[t]:sbf = 1:sbf) &&
      ((i2[t]:sbf = 1:sbf) ||
       ((i3[t]:sbf = 1:sbf) && (i5[t]:sbf = 1:sbf)) ||
       ((i4[t]:sbf = 1:sbf) && (i6[t]:sbf = 1:sbf)))) ||
     ((i9[t]:sbf = 0:sbf) && (i10[t]:sbf = 0:sbf) && (i11[t]:sbf = 1:sbf) &&
      (i1[t]:sbf = 0:sbf) &&
      !((i7[t]:sbf = 1:sbf) && (i8[t]:sbf = 1:sbf) &&
        ((i2[t]:sbf = 1:sbf) ||
         ((i3[t]:sbf = 1:sbf) && (i5[t]:sbf = 1:sbf)) ||
         ((i4[t]:sbf = 1:sbf) && (i6[t]:sbf = 1:sbf)))))))) &&
  (o2[t]:sbf = 1:sbf <-> ((o1[t]:sbf = 1:sbf) && ((i9[t]:sbf = 1:sbf) || (i10[t]:sbf = 1:sbf)))).
