# Perp ADL Activation Guard v1
#
# PURPOSE:
# Require explicit distress preconditions before ADL activation and enforce
# bounded ADL tier values.
#
# i1 = adl_requested (sbf)
# i2 = socialized_loss_flag (sbf)
# i3 = insurance_balance (bv[32])
# i4 = insurance_floor (bv[32])
# i5 = adl_tier (bv[32])
# i6 = max_adl_tier (bv[32])
# i7 = proof_ok (sbf)
# i8 = binding_ok (sbf)
#
# o1 = adl_precondition_ok
# o2 = adl_tier_ok
# o3 = adl_activation_safe
# o4 = proof_gated_adl_activation_safe

set charvar off

adl_precondition_ok(adl_requested : sbf, socialized_loss_flag : sbf, insurance_balance : bv[32], insurance_floor : bv[32]) :=
  (adl_requested = 0:sbf) || ((socialized_loss_flag = 1:sbf) && (insurance_balance < insurance_floor)).

adl_tier_ok(adl_tier : bv[32], max_adl_tier : bv[32]) := adl_tier <= max_adl_tier.

adl_activation_safe(adl_requested : sbf, socialized_loss_flag : sbf, insurance_balance : bv[32], insurance_floor : bv[32], adl_tier : bv[32], max_adl_tier : bv[32]) :=
  adl_precondition_ok(adl_requested, socialized_loss_flag, insurance_balance, insurance_floor) &&
  adl_tier_ok(adl_tier, max_adl_tier).

proof_gated_adl_activation_safe(adl_requested : sbf, socialized_loss_flag : sbf, insurance_balance : bv[32], insurance_floor : bv[32], adl_tier : bv[32], max_adl_tier : bv[32], proof_ok : sbf, binding_ok : sbf) :=
  adl_activation_safe(adl_requested, socialized_loss_flag, insurance_balance, insurance_floor, adl_tier, max_adl_tier) &&
  (proof_ok = 1:sbf) &&
  (binding_ok = 1:sbf).

always
  (o1[t]:sbf = 1:sbf <-> adl_precondition_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:bv[32], i4[t]:bv[32])) &&
  (o2[t]:sbf = 1:sbf <-> adl_tier_ok(i5[t]:bv[32], i6[t]:bv[32])) &&
  (o3[t]:sbf = 1:sbf <-> adl_activation_safe(i1[t]:sbf, i2[t]:sbf, i3[t]:bv[32], i4[t]:bv[32], i5[t]:bv[32], i6[t]:bv[32])) &&
  (o4[t]:sbf = 1:sbf <-> proof_gated_adl_activation_safe(i1[t]:sbf, i2[t]:sbf, i3[t]:bv[32], i4[t]:bv[32], i5[t]:bv[32], i6[t]:bv[32], i7[t]:sbf, i8[t]:sbf)).
