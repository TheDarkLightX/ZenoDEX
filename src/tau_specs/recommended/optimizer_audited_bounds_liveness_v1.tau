set charvar off

budget_facts_ok(selected_domain_budget_respected : sbf, repaired_selection_budget_respected : sbf, full_domain_pool_budget_respected : sbf, full_domain_candidate_budget_respected : sbf, budget_parameters_bound : sbf) :=
  (selected_domain_budget_respected = 1:sbf) &&
  (repaired_selection_budget_respected = 1:sbf) &&
  (full_domain_pool_budget_respected = 1:sbf) &&
  (full_domain_candidate_budget_respected = 1:sbf) &&
  (budget_parameters_bound = 1:sbf).

public_outcome_explicit(failure_path_explicit : sbf, success_path_replayable : sbf) :=
  (failure_path_explicit = 1:sbf) &&
  (success_path_replayable = 1:sbf).

audited_bounds_contract_ok(selected_domain_budget_respected : sbf, repaired_selection_budget_respected : sbf, full_domain_pool_budget_respected : sbf, full_domain_candidate_budget_respected : sbf, budget_parameters_bound : sbf, failure_path_explicit : sbf, success_path_replayable : sbf) :=
  budget_facts_ok(selected_domain_budget_respected, repaired_selection_budget_respected, full_domain_pool_budget_respected, full_domain_candidate_budget_respected, budget_parameters_bound) &&
  public_outcome_explicit(failure_path_explicit, success_path_replayable).

always
  (o1[t]:sbf = 1:sbf <-> budget_facts_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> public_outcome_explicit(i6[t]:sbf, i7[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> audited_bounds_contract_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf)).
