# M6 Writer Emergency Failover Guard v1
# Verifies the exceptional Tau-to-ZenoLedger transition. It requires a
# precommitted permit, observed Tau failure, finalized checkpoint import,
# writer revocation, writer-epoch advance, and cross-source parity.
#
# i1/i2/i3 = current Tau writer / ZenoLedger writer / quiesced
# i4/i5/i6 = next Tau writer / ZenoLedger writer / quiesced
# i7/i8/i9 = Tau current / ZenoLedger current / ZenoLedger ancestry valid
# i10/i11/i12 = emergency requested / permit / Tau unavailable or censoring
# i13 = finalized accepted Tau checkpoint imported
# i14/i15 = no in-flight publication / old writer revoked
# i16/i17 = current epoch bound / next epoch valid
# i18 = cross-source state parity
# i19/i20/i21/i22 = context / transition request / no-dual / proof
# i23 = binding accepted
# i24 = split-brain spending and dual issuance proved impossible
# o1 = emergency failover accepted

set charvar off

always
  (o1[t]:sbf = 1:sbf <-> (
    (i1[t]:sbf = 1:sbf) && (i2[t]:sbf = 0:sbf) && (i3[t]:sbf = 0:sbf) &&
    (i4[t]:sbf = 0:sbf) && (i5[t]:sbf = 1:sbf) && (i6[t]:sbf = 0:sbf) &&
    (i7[t]:sbf = 0:sbf) && (i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf) &&
    (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf) &&
    (i12[t]:sbf = 1:sbf) && (i13[t]:sbf = 1:sbf) &&
    (i14[t]:sbf = 1:sbf) && (i15[t]:sbf = 1:sbf) &&
    (i16[t]:sbf = 1:sbf) && (i17[t]:sbf = 1:sbf) &&
    (i18[t]:sbf = 1:sbf) && (i19[t]:sbf = 1:sbf) &&
    (i20[t]:sbf = 1:sbf) && (i21[t]:sbf = 1:sbf) &&
    (i22[t]:sbf = 1:sbf) && (i23[t]:sbf = 1:sbf) &&
    (i24[t]:sbf = 1:sbf))).
