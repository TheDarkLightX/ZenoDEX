# Route Split Window Certificate v1
#
# PURPOSE:
#   Guard a host-computed exact-out two-pool split certificate. The host keeps
#   quote replay, integer CPMM rounding, derivative-window search, and bounded
#   full-oracle parity. Tau only combines the proof-surface facts and preserves
#   the no-authority rail.
#
# Stream mapping:
# i1  = split_request_active
# i2  = domain_nonempty
# i3  = window_search_replayed
# i4  = local_window_certificate_ok
# i5  = full_oracle_parity_ok
# i6  = quote_replay_ok
# i7  = integer_rounding_scope_ok
# i8  = resource_budget_ok
# i9  = fallback_available_or_explicit_failure
# i10 = no_settlement_authority
# i11 = exact_out_scope_ok
# o1  = window_search_ok
# o2  = proof_surface_ok
# o3  = fallback_boundary_ok
# o4  = route_split_window_certificate_ok
# o5  = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
window_search_ok(domain : sbf, replayed : sbf, local_ok : sbf) := is1(domain) && is1(replayed) && is1(local_ok).
proof_surface_ok(parity : sbf, quote_replay : sbf, rounding : sbf, budget : sbf, exact_out_scope : sbf) := is1(parity) && is1(quote_replay) && is1(rounding) && is1(budget) && is1(exact_out_scope).
fallback_boundary_ok(fallback_ok : sbf, no_authority : sbf) := is1(fallback_ok) && is1(no_authority).
route_split_ok(active : sbf, domain : sbf, replayed : sbf, local_ok : sbf, parity : sbf, quote_replay : sbf, rounding : sbf, budget : sbf, fallback_ok : sbf, no_authority : sbf, exact_out_scope : sbf) := is1(active) && window_search_ok(domain, replayed, local_ok) && proof_surface_ok(parity, quote_replay, rounding, budget, exact_out_scope) && fallback_boundary_ok(fallback_ok, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> window_search_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> proof_surface_ok(i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i11[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> fallback_boundary_ok(i9[t]:sbf, i10[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> route_split_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i10[t]:sbf))).
