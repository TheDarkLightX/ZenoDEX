# tauspec_ebrm_frontier_selection_certificate_v1.tau
#
# PURPOSE:
#   Admit a host-replayed TauSpecEBRM frontier-selection certificate. The host
#   runs Tau traces, computes baseline rankings, counts invalid accepts, and
#   binds work-item coverage. Tau only composes those facts into a fail-closed
#   research certificate with no settlement, oracle, or governance authority.
#
# Stream mapping:
# i1  = certificate_active
# i2  = candidate_pool_bound_ok
# i3  = tau_traces_passed
# i4  = invalid_accepts_zero
# i5  = topk_not_worse_than_baselines
# i6  = work_item_1_ab_covered
# i7  = work_item_2_cow_covered
# i8  = deterministic_replay_ok
# i9  = advisory_model_only
# i10 = performance_profile_bound_ok
# i11 = no_authority_effect
#
# o1 = replay_evidence_ok
# o2 = selector_quality_ok
# o3 = work_item_coverage_ok
# o4 = authority_boundary_ok
# o5 = tauspec_ebrm_selection_certificate_ok
# o6 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
replay_evidence_ok(pool_ok : sbf, traces_ok : sbf, invalid_zero : sbf, deterministic_ok : sbf, profile_ok : sbf) := is1(pool_ok) && is1(traces_ok) && is1(invalid_zero) && is1(deterministic_ok) && is1(profile_ok).
selector_quality_ok(topk_ok : sbf, invalid_zero : sbf) := is1(topk_ok) && is1(invalid_zero).
work_item_coverage_ok(ab_ok : sbf, cow_ok : sbf) := is1(ab_ok) && is1(cow_ok).
authority_boundary_ok(advisory_only : sbf, no_authority : sbf) := is1(advisory_only) && is1(no_authority).
selection_certificate_ok(active : sbf, pool_ok : sbf, traces_ok : sbf, invalid_zero : sbf, topk_ok : sbf, ab_ok : sbf, cow_ok : sbf, deterministic_ok : sbf, advisory_only : sbf, profile_ok : sbf, no_authority : sbf) := is1(active) && replay_evidence_ok(pool_ok, traces_ok, invalid_zero, deterministic_ok, profile_ok) && selector_quality_ok(topk_ok, invalid_zero) && work_item_coverage_ok(ab_ok, cow_ok) && authority_boundary_ok(advisory_only, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> replay_evidence_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i8[t]:sbf, i10[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> selector_quality_ok(i5[t]:sbf, i4[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> work_item_coverage_ok(i6[t]:sbf, i7[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> authority_boundary_ok(i9[t]:sbf, i11[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> selection_certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i11[t]:sbf))).
