# AB Child-Frontier Corpus-Root Scope Certificate v1
#
# PURPOSE:
#   Admit a research-only certificate for the AB strict zero-min reserve-state
#   child-frontier corpus root. The host checks the corpus-root JSON report,
#   pinned digests, row and case coverage, linked cross-binding evidence,
#   deterministic replay, negative controls, and the no-authority boundary.
#   Tau only composes those host facts into a fail-closed envelope.
#
# Stream mapping:
# i1  = certificate_active
# i2  = source_report_ok
# i3  = n7_zero_min_scope_ok
# i4  = corpus_root_pinned
# i5  = case_roots_covered
# i6  = row_receipts_complete
# i7  = membership_proofs_clean
# i8  = negative_controls_reject
# i9  = deterministic_replay_ok
# i10 = linked_cross_binding_ok
# i11 = digest_pins_ok
# i12 = authority_boundary_ok
# i13 = no_authority_effect
# i14 = corpus_nonvacuous
#
# o1 = scope_ok
# o2 = corpus_commitment_ok
# o3 = row_membership_ok
# o4 = replay_and_refutation_ok
# o5 = linked_evidence_ok
# o6 = authority_boundary_ok
# o7 = corpus_root_certificate_ok
# o8 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
scope_ok(source_report : sbf, n7_zero_min : sbf, nonvacuous : sbf) := is1(source_report) && is1(n7_zero_min) && is1(nonvacuous).
corpus_commitment_ok(corpus_root : sbf, case_roots : sbf, digest_pins : sbf) := is1(corpus_root) && is1(case_roots) && is1(digest_pins).
row_membership_ok(row_receipts : sbf, membership_clean : sbf) := is1(row_receipts) && is1(membership_clean).
replay_and_refutation_ok(deterministic_replay : sbf, negative_controls : sbf) := is1(deterministic_replay) && is1(negative_controls).
linked_evidence_ok(cross_binding : sbf, digest_pins : sbf) := is1(cross_binding) && is1(digest_pins).
authority_ok(boundary : sbf, no_authority : sbf) := is1(boundary) && is1(no_authority).
certificate_ok(active : sbf, source_report : sbf, n7_zero_min : sbf, corpus_root : sbf, case_roots : sbf, row_receipts : sbf, membership_clean : sbf, negative_controls : sbf, deterministic_replay : sbf, cross_binding : sbf, digest_pins : sbf, boundary : sbf, no_authority : sbf, nonvacuous : sbf) := is1(active) && scope_ok(source_report, n7_zero_min, nonvacuous) && corpus_commitment_ok(corpus_root, case_roots, digest_pins) && row_membership_ok(row_receipts, membership_clean) && replay_and_refutation_ok(deterministic_replay, negative_controls) && linked_evidence_ok(cross_binding, digest_pins) && authority_ok(boundary, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> scope_ok(i2[t]:sbf, i3[t]:sbf, i14[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> corpus_commitment_ok(i4[t]:sbf, i5[t]:sbf, i11[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> row_membership_ok(i6[t]:sbf, i7[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> replay_and_refutation_ok(i9[t]:sbf, i8[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> linked_evidence_ok(i10[t]:sbf, i11[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> authority_ok(i12[t]:sbf, i13[t]:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf)) &&
  (o8[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i13[t]:sbf))).
