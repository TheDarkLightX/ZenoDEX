# cpss_bc_research_scope_certificate_v1.tau
#
# PURPOSE:
#   Admit a host-replayed research-scope certificate for the CPSS-BC batch
#   clearing bundle. The host checks proof compilation, forbidden proof tokens,
#   corrected mechanism-design scope, recorded falsifications, replay artifact
#   presence, and the no-authority boundary. Tau only composes those facts into
#   a fail-closed research certificate.
#
# Stream mapping:
# i1  = certificate_active
# i2  = artifacts_present
# i3  = lean_compile_ok
# i4  = lean_no_forbidden_tokens
# i5  = compressed_state_scope_ok
# i6  = adaptive_window_empirical_only
# i7  = single_user_sp_proven
# i8  = group_sp_falsified
# i9  = precommit_collusion_documented
# i10 = cpss_greedy_dominance_falsified
# i11 = production_nonclaims_bound
# i12 = replay_scripts_present
# i13 = no_authority_effect
# i14 = phase2_replay_scripts_execute
#
# o1 = formal_evidence_ok
# o2 = falsification_scope_ok
# o3 = replay_bundle_ok
# o4 = authority_boundary_ok
# o5 = cpss_bc_research_scope_certificate_ok
# o6 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
formal_evidence_ok(lean_ok : sbf, clean_tokens : sbf, compressed_scope : sbf, single_sp : sbf) := is1(lean_ok) && is1(clean_tokens) && is1(compressed_scope) && is1(single_sp).
falsification_scope_ok(window_empirical : sbf, group_sp_bad : sbf, precommit_bad : sbf, dominance_bad : sbf, nonclaims : sbf) := is1(window_empirical) && is1(group_sp_bad) && is1(precommit_bad) && is1(dominance_bad) && is1(nonclaims).
replay_bundle_ok(artifacts : sbf, scripts_present : sbf, scripts_execute : sbf) := is1(artifacts) && is1(scripts_present) && is1(scripts_execute).
authority_boundary_ok(no_authority : sbf) := is1(no_authority).
certificate_ok(active : sbf, artifacts : sbf, lean_ok : sbf, clean_tokens : sbf, compressed_scope : sbf, window_empirical : sbf, single_sp : sbf, group_sp_bad : sbf, precommit_bad : sbf, dominance_bad : sbf, nonclaims : sbf, scripts_present : sbf, no_authority : sbf, scripts_execute : sbf) := is1(active) && formal_evidence_ok(lean_ok, clean_tokens, compressed_scope, single_sp) && falsification_scope_ok(window_empirical, group_sp_bad, precommit_bad, dominance_bad, nonclaims) && replay_bundle_ok(artifacts, scripts_present, scripts_execute) && authority_boundary_ok(no_authority).

always
  (o1[t]:sbf = 1:sbf <-> formal_evidence_ok(i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i7[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> falsification_scope_ok(i6[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> replay_bundle_ok(i2[t]:sbf, i12[t]:sbf, i14[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> authority_boundary_ok(i13[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i13[t]:sbf))).
