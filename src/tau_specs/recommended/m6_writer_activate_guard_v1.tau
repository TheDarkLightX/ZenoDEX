# M6 Writer Activate Guard v1
# Verifies activation of exactly one writer from a quiesced state.
#
# i1/i2/i3 = current Tau writer / ZenoLedger writer / quiesced
# i4/i5/i6 = next Tau writer / ZenoLedger writer / quiesced
# i7/i8/i9 = Tau current / ZenoLedger current / ZenoLedger ancestry valid
# i10 = normal handoff receipt bound
# i11/i12/i13 = quiescence / no in-flight publication / old writer revoked
# i14/i15 = current epoch bound / next epoch valid
# i16 = cross-source state parity
# i17/i18/i19/i20 = context / request / no-dual / proof
# i21 = binding accepted
# o1 = activation accepted

set charvar off

always
  (o1[t]:sbf = 1:sbf <-> (
    (i1[t]:sbf = 0:sbf) && (i2[t]:sbf = 0:sbf) && (i3[t]:sbf = 1:sbf) &&
    (i6[t]:sbf = 0:sbf) && (i10[t]:sbf = 1:sbf) &&
    (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf) &&
    (i13[t]:sbf = 1:sbf) && (i14[t]:sbf = 1:sbf) &&
    (i15[t]:sbf = 1:sbf) && (i16[t]:sbf = 1:sbf) &&
    (i17[t]:sbf = 1:sbf) && (i18[t]:sbf = 1:sbf) &&
    (i19[t]:sbf = 1:sbf) && (i20[t]:sbf = 1:sbf) && (i21[t]:sbf = 1:sbf) &&
    (((i4[t]:sbf = 1:sbf) && (i5[t]:sbf = 0:sbf) && (i7[t]:sbf = 1:sbf)) ||
     ((i4[t]:sbf = 0:sbf) && (i5[t]:sbf = 1:sbf) &&
      (i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf))))).
