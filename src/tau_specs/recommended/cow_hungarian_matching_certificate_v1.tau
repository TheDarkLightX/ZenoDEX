# cow_hungarian_matching_certificate_v1.tau
#
# PURPOSE:
#   Admit a research certificate for the CoW matching work item. The host
#   computes the assignment witness, primal and dual feasibility, complementary
#   slackness, bounded brute-force parity, deterministic ties, and a fail-closed
#   boundary when grouped-capacity constraints appear. Tau composes those facts
#   into a no-authority certificate.
#
# Stream mapping:
# i1  = solver_active
# i2  = uncoupled_bipartite_scope_ok
# i3  = objective_binding_ok
# i4  = primal_matching_valid
# i5  = dual_prices_feasible
# i6  = complementary_slackness_ok
# i7  = brute_assignment_parity_under_bound
# i8  = grouped_capacity_absent_or_fallback
# i9  = deterministic_tie_break_ok
# i10 = resource_budget_ok
# i11 = no_settlement_authority
# i12 = transcript_binding_ok
#
# o1 = matching_scope_ok
# o2 = primal_dual_certificate_ok
# o3 = replay_and_fallback_ok
# o4 = authority_boundary_ok
# o5 = cow_hungarian_certificate_ok
# o6 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
matching_scope_ok(scope_ok : sbf, objective_ok : sbf) := is1(scope_ok) && is1(objective_ok).
primal_dual_certificate_ok(primal_ok : sbf, dual_ok : sbf, slackness_ok : sbf, tie_ok : sbf) := is1(primal_ok) && is1(dual_ok) && is1(slackness_ok) && is1(tie_ok).
replay_and_fallback_ok(parity_ok : sbf, grouped_fallback_ok : sbf, budget_ok : sbf, binding_ok : sbf) := is1(parity_ok) && is1(grouped_fallback_ok) && is1(budget_ok) && is1(binding_ok).
authority_boundary_ok(no_authority : sbf, binding_ok : sbf) := is1(no_authority) && is1(binding_ok).
certificate_ok(active : sbf, scope_ok : sbf, objective_ok : sbf, primal_ok : sbf, dual_ok : sbf, slackness_ok : sbf, parity_ok : sbf, grouped_fallback_ok : sbf, tie_ok : sbf, budget_ok : sbf, no_authority : sbf, binding_ok : sbf) := is1(active) && matching_scope_ok(scope_ok, objective_ok) && primal_dual_certificate_ok(primal_ok, dual_ok, slackness_ok, tie_ok) && replay_and_fallback_ok(parity_ok, grouped_fallback_ok, budget_ok, binding_ok) && authority_boundary_ok(no_authority, binding_ok).

always
  (o1[t]:sbf = 1:sbf <-> matching_scope_ok(i2[t]:sbf, i3[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> primal_dual_certificate_ok(i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i9[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> replay_and_fallback_ok(i7[t]:sbf, i8[t]:sbf, i10[t]:sbf, i12[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> authority_boundary_ok(i11[t]:sbf, i12[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i11[t]:sbf))).
