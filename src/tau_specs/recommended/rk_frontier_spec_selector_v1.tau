# Research Kernel Frontier Spec Selector v1
#
# PURPOSE:
#   Guard a host-computed selector for the next ZenoDEX Tau-spec research queue.
#   The host snapshots Research Kernel frontier atoms, reduces them to bounded
#   candidate experiments, solves a budgeted max-coverage DP, compares simple
#   baselines, and supplies the resulting facts. Tau only combines projected
#   facts and preserves the no-authority boundary.
#
# Stream mapping:
# i1  = selector_active
# i2  = deterministic_replay_ok
# i3  = exact_dp_complete
# i4  = required_axes_covered
# i5  = dominates_priority_baseline
# i6  = dominates_single_lens_baseline
# i7  = negative_controls_ok
# i8  = tau_runtime_subset_ok
# i9  = resource_budget_ok
# i10 = rk_dependencies_ok
# i11 = no_authority_effect
# i12 = nonvacuous_selection
# i13 = replay_evidence_ok
# o1  = exact_replay_ok
# o2  = frontier_selection_ok
# o3  = safety_boundary_ok
# o4  = rk_frontier_selector_ok
# o5  = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
exact_replay_ok(deterministic : sbf, exact_complete : sbf, evidence : sbf, nonvacuous : sbf) := is1(deterministic) && is1(exact_complete) && is1(evidence) && is1(nonvacuous).
frontier_selection_ok(axes : sbf, priority : sbf, single_lens : sbf, dependencies : sbf) := is1(axes) && is1(priority) && is1(single_lens) && is1(dependencies).
safety_boundary_ok(negative_controls : sbf, tau_subset : sbf, budget : sbf, no_authority : sbf) := is1(negative_controls) && is1(tau_subset) && is1(budget) && is1(no_authority).
selector_ok(active : sbf, deterministic : sbf, exact_complete : sbf, axes : sbf, priority : sbf, single_lens : sbf, negative_controls : sbf, tau_subset : sbf, budget : sbf, dependencies : sbf, no_authority : sbf, nonvacuous : sbf, evidence : sbf) := is1(active) && exact_replay_ok(deterministic, exact_complete, evidence, nonvacuous) && frontier_selection_ok(axes, priority, single_lens, dependencies) && safety_boundary_ok(negative_controls, tau_subset, budget, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> exact_replay_ok(i2[t]:sbf, i3[t]:sbf, i13[t]:sbf, i12[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> frontier_selection_ok(i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i10[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> safety_boundary_ok(i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i11[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> selector_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i11[t]:sbf))).
