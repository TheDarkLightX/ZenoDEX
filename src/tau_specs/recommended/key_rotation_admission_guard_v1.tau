# Key Rotation Admission Guard v1
#
# PURPOSE:
# Admit wallet key rotation only when the old key authorizes, the new key binds,
# no stale/pending recovery race is active, replay is clear, and both signing and
# recovery paths remain live after rotation.
#
# i1 = rotation_requested (sbf)
# i2 = old_key_auth_ok (sbf)
# i3 = new_key_binding_ok (sbf)
# i4 = key_id_changes (sbf)
# i5 = rotated_key_not_current (sbf)
# i6 = cooldown_elapsed (sbf)
# i7 = no_pending_recovery (sbf)
# i8 = replay_frontier_clear (sbf)
# i9 = post_primary_signing_path_live (sbf)
# i10 = post_recovery_path_live (sbf)
# i11 = proof_ok (sbf)
# i12 = binding_ok (sbf)
#
# o1 = rotation_admissible
# o2 = proof_gated_rotation_admissible

set charvar off

always
  (o1[t]:sbf = 1:sbf <-> ((i1[t]:sbf = 1:sbf) && (i2[t]:sbf = 1:sbf) && (i3[t]:sbf = 1:sbf) && (i4[t]:sbf = 1:sbf) && (i5[t]:sbf = 1:sbf) && (i6[t]:sbf = 1:sbf) && (i7[t]:sbf = 1:sbf) && (i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf) && (i10[t]:sbf = 1:sbf))) &&
  (o2[t]:sbf = 1:sbf <-> ((o1[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf))).
