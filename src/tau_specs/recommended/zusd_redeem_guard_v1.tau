# zUSD Redeem Guard v1 (transition-aware)
# i1  = amount (bv[64])
# i2  = debt_before (bv[64])
# i3  = free_before (bv[64])
# i4  = collateral_before (bv[64])
# i5  = debt_after (bv[64])
# i6  = free_after (bv[64])
# i7  = collateral_after (bv[64])
# i8  = gross_collateral (bv[64])
# i9  = fee_collateral (bv[64])
# i10 = oracle_ok (sbf)
# i11 = mcr_post_ok (sbf)
# i12 = fee_cap_ok (sbf)
# o4  = redeem_allowed

set charvar off

amount_pos(amount : bv[64]) := amount > { #x0000000000000000 }:bv[64].
debt_pre_ok(debt_b : bv[64], free_b : bv[64], amount : bv[64]) := (debt_b >= amount) && (free_b >= amount).
debt_delta_ok(debt_b : bv[64], debt_a : bv[64], amount : bv[64]) := (debt_b >= debt_a) && ((debt_b - debt_a) = amount).
free_delta_ok(free_b : bv[64], free_a : bv[64], amount : bv[64]) := (free_b >= free_a) && ((free_b - free_a) = amount).
coll_delta_ok(coll_b : bv[64], coll_a : bv[64], gross : bv[64]) := (coll_b >= coll_a) && ((coll_b - coll_a) = gross).
fee_shape_ok(gross : bv[64], fee : bv[64]) := (gross > { #x0000000000000000 }:bv[64]) && (gross > fee).
redeem_allowed(amount : bv[64], debt_b : bv[64], free_b : bv[64], coll_b : bv[64], debt_a : bv[64], free_a : bv[64], coll_a : bv[64], gross : bv[64], fee : bv[64], oracle_ok : sbf, mcr_post_ok : sbf, fee_cap_ok : sbf) := amount_pos(amount) && debt_pre_ok(debt_b, free_b, amount) && debt_delta_ok(debt_b, debt_a, amount) && free_delta_ok(free_b, free_a, amount) && coll_delta_ok(coll_b, coll_a, gross) && fee_shape_ok(gross, fee) && (oracle_ok = 1:sbf) && (mcr_post_ok = 1:sbf) && (fee_cap_ok = 1:sbf).
always (o1[t]:sbf = 1:sbf <-> (debt_pre_ok(i2[t]:bv[64], i3[t]:bv[64], i1[t]:bv[64]) && debt_delta_ok(i2[t]:bv[64], i5[t]:bv[64], i1[t]:bv[64]) && free_delta_ok(i3[t]:bv[64], i6[t]:bv[64], i1[t]:bv[64]))) && (o2[t]:sbf = 1:sbf <-> (coll_delta_ok(i4[t]:bv[64], i7[t]:bv[64], i8[t]:bv[64]) && fee_shape_ok(i8[t]:bv[64], i9[t]:bv[64]))) && (o3[t]:sbf = 1:sbf <-> ((i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf))) && (o4[t]:sbf = 1:sbf <-> redeem_allowed(i1[t]:bv[64], i2[t]:bv[64], i3[t]:bv[64], i4[t]:bv[64], i5[t]:bv[64], i6[t]:bv[64], i7[t]:bv[64], i8[t]:bv[64], i9[t]:bv[64], i10[t]:sbf, i11[t]:sbf, i12[t]:sbf)).
