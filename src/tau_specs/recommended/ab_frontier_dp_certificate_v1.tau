# AB Frontier-DP Certificate v1
#
# PURPOSE:
#   Admit a host-replayed certificate for a bounded AB ordering experiment that
#   compares brute force, full-state subset DP, and a dominance-pruned frontier
#   DP on exact-in same-direction CPMM batches. The certificate can record a
#   safe-but-not-useful dominance result: no AB loss, pruning attempts observed,
#   and no production authority. Tau checks only proof-surface facts and
#   no-authority rails; it does not compute ordering or authorize settlement.
#
# Stream mapping:
# i1  = certificate_active
# i2  = exact_in_same_direction_scope_ok
# i3  = brute_force_oracle_parity_ok
# i4  = full_state_dp_parity_ok
# i5  = frontier_dominance_no_loss_ok
# i6  = dominance_pruning_observed
# i7  = deterministic_tie_ok
# i8  = negative_replay_ok
# i9  = resource_budget_ok
# i10 = fallback_boundary_ok
# i11 = advisory_only
# i12 = no_authority_effect
#
# o1 = oracle_evidence_ok
# o2 = dominance_evidence_ok
# o3 = rollout_boundary_ok
# o4 = ab_frontier_dp_research_certificate_ok
# o5 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
oracle_evidence_ok(scope_ok : sbf, brute_ok : sbf, full_state_ok : sbf, tie_ok : sbf, negative_ok : sbf) := is1(scope_ok) && is1(brute_ok) && is1(full_state_ok) && is1(tie_ok) && is1(negative_ok).
dominance_evidence_ok(no_loss : sbf, pruning : sbf, budget : sbf) := is1(no_loss) && is1(pruning) && is1(budget).
rollout_boundary_ok(fallback_ok : sbf, advisory_only : sbf, no_authority : sbf) := is1(fallback_ok) && is1(advisory_only) && is1(no_authority).
certificate_ok(active : sbf, scope_ok : sbf, brute_ok : sbf, full_state_ok : sbf, no_loss : sbf, reduction : sbf, tie_ok : sbf, negative_ok : sbf, budget : sbf, fallback_ok : sbf, advisory_only : sbf, no_authority : sbf) := is1(active) && oracle_evidence_ok(scope_ok, brute_ok, full_state_ok, tie_ok, negative_ok) && dominance_evidence_ok(no_loss, reduction, budget) && rollout_boundary_ok(fallback_ok, advisory_only, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> oracle_evidence_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i7[t]:sbf, i8[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> dominance_evidence_ok(i5[t]:sbf, i6[t]:sbf, i9[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> rollout_boundary_ok(i10[t]:sbf, i11[t]:sbf, i12[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i12[t]:sbf))).
