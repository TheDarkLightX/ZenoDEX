# zUSD Liquidation Guard v2 (bv[64], no narrow safe-range assumption)
# i1 = pending_init (sbf)
# i2 = vault_debt (bv[64])
# i3 = under_mcr (sbf)
# i4 = sp_debt (bv[64])
# i5 = vault_coll (bv[64])
# i6 = sp_coll_before (bv[64])
# i7 = max_sp_coll (bv[64])
# o4 = liquidation_allowed

set charvar off

positive_debt(debt : bv[64]) := debt > { #x0000000000000000 }:bv[64].
pre_ok(pending_init : sbf, debt : bv[64], under_mcr : sbf) := (pending_init = 1:sbf) && positive_debt(debt) && (under_mcr = 1:sbf).
debt_absorbable(vault_debt : bv[64], sp_debt : bv[64]) := sp_debt >= vault_debt.
coll_cap_ok(vault_coll : bv[64], sp_coll_before : bv[64], max_sp_coll : bv[64]) := (max_sp_coll >= sp_coll_before) && ((max_sp_coll - sp_coll_before) >= vault_coll).
liquidation_allowed(pending_init : sbf, vault_debt : bv[64], under_mcr : sbf, sp_debt : bv[64], vault_coll : bv[64], sp_coll_before : bv[64], max_sp_coll : bv[64]) := pre_ok(pending_init, vault_debt, under_mcr) && debt_absorbable(vault_debt, sp_debt) && coll_cap_ok(vault_coll, sp_coll_before, max_sp_coll).
always (o1[t]:sbf = 1:sbf <-> debt_absorbable(i2[t]:bv[64], i4[t]:bv[64])) && (o2[t]:sbf = 1:sbf <-> coll_cap_ok(i5[t]:bv[64], i6[t]:bv[64], i7[t]:bv[64])) && (o3[t]:sbf = 1:sbf <-> pre_ok(i1[t]:sbf, i2[t]:bv[64], i3[t]:sbf)) && (o4[t]:sbf = 1:sbf <-> liquidation_allowed(i1[t]:sbf, i2[t]:bv[64], i3[t]:sbf, i4[t]:bv[64], i5[t]:bv[64], i6[t]:bv[64], i7[t]:bv[64])).
