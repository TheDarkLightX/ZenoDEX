# Experimental batching 4-element set inclusion rail
#
# Inputs:
# i1..i4 = left tuple
# i5..i8 = right tuple
# o1 = left_in_right_ok

set charvar off

always (o1[t]:sbf = 1:sbf <-> ((((i1[t]:bv[64] = i5[t]:bv[64]) || (i1[t]:bv[64] = i6[t]:bv[64]) || (i1[t]:bv[64] = i7[t]:bv[64]) || (i1[t]:bv[64] = i8[t]:bv[64])) && ((i2[t]:bv[64] = i5[t]:bv[64]) || (i2[t]:bv[64] = i6[t]:bv[64]) || (i2[t]:bv[64] = i7[t]:bv[64]) || (i2[t]:bv[64] = i8[t]:bv[64])) && ((i3[t]:bv[64] = i5[t]:bv[64]) || (i3[t]:bv[64] = i6[t]:bv[64]) || (i3[t]:bv[64] = i7[t]:bv[64]) || (i3[t]:bv[64] = i8[t]:bv[64])) && ((i4[t]:bv[64] = i5[t]:bv[64]) || (i4[t]:bv[64] = i6[t]:bv[64]) || (i4[t]:bv[64] = i7[t]:bv[64]) || (i4[t]:bv[64] = i8[t]:bv[64]))))).
