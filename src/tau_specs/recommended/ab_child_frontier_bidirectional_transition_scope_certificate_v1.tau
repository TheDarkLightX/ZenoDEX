# AB Child-Frontier Bidirectional Transition Scope Certificate v1
#
# PURPOSE:
#   Admit a research-only certificate for the AB strict zero-min reserve-state
#   child-frontier bidirectional transition closure. The host checks the JSON
#   report, pinned digests, transition-row coverage, linked child-coverage
#   evidence, deterministic replay, negative controls, and no-authority rail.
#   Tau only composes those host facts into a fail-closed envelope.
#
# Stream mapping:
# i1  = certificate_active
# i2  = source_report_ok
# i3  = n7_zero_min_scope_ok
# i4  = transition_counts_complete
# i5  = generated_child_count_ok
# i6  = linked_child_coverage_ok
# i7  = transition_digest_pinned
# i8  = linked_digest_pinned
# i9  = deterministic_replay_ok
# i10 = negative_controls_reject
# i11 = authority_boundary_ok
# i12 = no_authority_effect
# i13 = corpus_nonvacuous
#
# o1 = scope_ok
# o2 = transition_closure_ok
# o3 = linked_coverage_ok
# o4 = replay_and_refutation_ok
# o5 = digest_pins_ok
# o6 = authority_boundary_ok
# o7 = bidirectional_transition_certificate_ok
# o8 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
scope_ok(source_report : sbf, n7_zero_min : sbf, nonvacuous : sbf) := is1(source_report) && is1(n7_zero_min) && is1(nonvacuous).
transition_closure_ok(transition_counts : sbf, generated_child_count : sbf) := is1(transition_counts) && is1(generated_child_count).
linked_coverage_ok(linked_child_coverage : sbf, linked_digest : sbf) := is1(linked_child_coverage) && is1(linked_digest).
replay_and_refutation_ok(deterministic_replay : sbf, negative_controls : sbf) := is1(deterministic_replay) && is1(negative_controls).
digest_pins_ok(transition_digest : sbf, linked_digest : sbf) := is1(transition_digest) && is1(linked_digest).
authority_ok(boundary : sbf, no_authority : sbf) := is1(boundary) && is1(no_authority).
certificate_ok(active : sbf, source_report : sbf, n7_zero_min : sbf, transition_counts : sbf, generated_child_count : sbf, linked_child_coverage : sbf, transition_digest : sbf, linked_digest : sbf, deterministic_replay : sbf, negative_controls : sbf, boundary : sbf, no_authority : sbf, nonvacuous : sbf) := is1(active) && scope_ok(source_report, n7_zero_min, nonvacuous) && transition_closure_ok(transition_counts, generated_child_count) && linked_coverage_ok(linked_child_coverage, linked_digest) && replay_and_refutation_ok(deterministic_replay, negative_controls) && digest_pins_ok(transition_digest, linked_digest) && authority_ok(boundary, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> scope_ok(i2[t]:sbf, i3[t]:sbf, i13[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> transition_closure_ok(i4[t]:sbf, i5[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> linked_coverage_ok(i6[t]:sbf, i8[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> replay_and_refutation_ok(i9[t]:sbf, i10[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> digest_pins_ok(i7[t]:sbf, i8[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> authority_ok(i11[t]:sbf, i12[t]:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf)) &&
  (o8[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i12[t]:sbf))).
