# M6 Tau Substrate Profile Gate v1
#
# Mints one Boolean compatibility decision for one pinned Tau integration
# profile. The only accepting observation is VERIFIED_COMPATIBLE. Any
# unavailable, censoring, changed, equivocal, incompatible, or malformed
# observation fails closed.
#
# i1..i6 = Tau observation flags: verified-compatible / unavailable /
#           censoring / changed / equivocal / incompatible
# i7/i8 = all required capabilities present / profile refinement verified
# i9/i10/i11 = profile identity / governance root / rule history bound
# i12/i13 = proof / binding accepted
# o1 = exact Tau profile may be used

set charvar off

always
  (o1[t]:sbf = 1:sbf <-> (
    (i1[t]:sbf = 1:sbf) && (i2[t]:sbf = 0:sbf) &&
    (i3[t]:sbf = 0:sbf) && (i4[t]:sbf = 0:sbf) &&
    (i5[t]:sbf = 0:sbf) && (i6[t]:sbf = 0:sbf) &&
    (i7[t]:sbf = 1:sbf) && (i8[t]:sbf = 1:sbf) &&
    (i9[t]:sbf = 1:sbf) && (i10[t]:sbf = 1:sbf) &&
    (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf) &&
    (i13[t]:sbf = 1:sbf))).
