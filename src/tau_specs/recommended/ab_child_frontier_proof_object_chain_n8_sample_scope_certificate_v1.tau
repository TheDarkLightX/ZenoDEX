# AB Child-Frontier Proof-Object Chain N8 Sample Scope Certificate v1
#
# PURPOSE:
#   Admit a research-only certificate for the sampled n=8 AB strict zero-min
#   child-frontier proof-object chain. The host checks the five stage Tau
#   reports, shared sampled scope, cross-stage counts, digest consistency,
#   producer manifest links, replay/refutation evidence, chain-index hash, and
#   no-authority rail. Tau only composes those host facts into a fail-closed
#   envelope.
#
# Stream mapping:
# i1  = certificate_active
# i2  = generation_tau_ok
# i3  = canonical_merkle_tau_ok
# i4  = witness_compression_tau_ok
# i5  = bidirectional_transition_tau_ok
# i6  = producer_tau_ok
# i7  = shared_scope_ok
# i8  = stage_counts_ok
# i9  = cross_stage_digests_ok
# i10 = producer_manifest_links_ok
# i11 = negative_cases_clean
# i12 = deterministic_replay_pinned
# i13 = stage_report_hashes_pinned
# i14 = chain_index_hash_pinned
# i15 = authority_boundary_ok
# i16 = no_authority_effect
# i17 = corpus_nonvacuous
#
# o1 = stage_tau_reports_ok
# o2 = scope_and_counts_ok
# o3 = digest_chain_ok
# o4 = replay_and_refutation_ok
# o5 = authority_boundary_ok
# o6 = chain_index_pin_ok
# o7 = proof_object_chain_certificate_ok
# o8 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
stage_tau_reports_ok(generation : sbf, canonical_merkle : sbf, witness_compression : sbf, bidirectional_transition : sbf, producer : sbf) := is1(generation) && is1(canonical_merkle) && is1(witness_compression) && is1(bidirectional_transition) && is1(producer).
scope_and_counts_ok(shared_scope : sbf, stage_counts : sbf, nonvacuous : sbf) := is1(shared_scope) && is1(stage_counts) && is1(nonvacuous).
digest_chain_ok(cross_stage_digests : sbf, producer_links : sbf) := is1(cross_stage_digests) && is1(producer_links).
replay_and_refutation_ok(negative_cases : sbf, deterministic_replay : sbf, stage_report_hashes : sbf) := is1(negative_cases) && is1(deterministic_replay) && is1(stage_report_hashes).
authority_ok(boundary : sbf, no_authority : sbf) := is1(boundary) && is1(no_authority).
chain_index_pin_ok(chain_index_hash : sbf) := is1(chain_index_hash).
certificate_ok(active : sbf, generation : sbf, canonical_merkle : sbf, witness_compression : sbf, bidirectional_transition : sbf, producer : sbf, shared_scope : sbf, stage_counts : sbf, cross_stage_digests : sbf, producer_links : sbf, negative_cases : sbf, deterministic_replay : sbf, stage_report_hashes : sbf, chain_index_hash : sbf, boundary : sbf, no_authority : sbf, nonvacuous : sbf) := is1(active) && stage_tau_reports_ok(generation, canonical_merkle, witness_compression, bidirectional_transition, producer) && scope_and_counts_ok(shared_scope, stage_counts, nonvacuous) && digest_chain_ok(cross_stage_digests, producer_links) && replay_and_refutation_ok(negative_cases, deterministic_replay, stage_report_hashes) && chain_index_pin_ok(chain_index_hash) && authority_ok(boundary, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> stage_tau_reports_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> scope_and_counts_ok(i7[t]:sbf, i8[t]:sbf, i17[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> digest_chain_ok(i9[t]:sbf, i10[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> replay_and_refutation_ok(i11[t]:sbf, i12[t]:sbf, i13[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> authority_ok(i15[t]:sbf, i16[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> chain_index_pin_ok(i14[t]:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf, i15[t]:sbf, i16[t]:sbf, i17[t]:sbf)) &&
  (o8[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i16[t]:sbf))).
