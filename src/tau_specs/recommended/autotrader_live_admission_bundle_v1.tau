set charvar off

always
  (o1[t]:sbf = 1:sbf <-> (i1[t]:sbf = 1:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> (i2[t]:sbf = 1:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> (i3[t]:sbf = 1:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> (i4[t]:sbf = 1:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> (i5[t]:sbf = 1:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> (i6[t]:sbf = 1:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> (i7[t]:sbf = 1:sbf)) &&
  (o8[t]:sbf = 1:sbf <-> (i8[t]:sbf = 1:sbf)) &&
  (o9[t]:sbf = 1:sbf <-> (i9[t]:sbf = 1:sbf)) &&
  (o10[t]:sbf = 1:sbf <-> (i10[t]:sbf = 1:sbf)) &&
  (o11[t]:sbf = 1:sbf <-> (i11[t]:sbf = 1:sbf)) &&
  (
    o12[t]:sbf = 1:sbf <->
    (
      (i1[t]:sbf = 1:sbf) &&
      (i2[t]:sbf = 1:sbf) &&
      (i3[t]:sbf = 1:sbf) &&
      (i4[t]:sbf = 1:sbf) &&
      (i5[t]:sbf = 1:sbf) &&
      (i6[t]:sbf = 1:sbf) &&
      (i7[t]:sbf = 1:sbf) &&
      (i8[t]:sbf = 1:sbf) &&
      (i9[t]:sbf = 1:sbf) &&
      (i10[t]:sbf = 1:sbf) &&
      (i11[t]:sbf = 1:sbf)
    )
  ).
