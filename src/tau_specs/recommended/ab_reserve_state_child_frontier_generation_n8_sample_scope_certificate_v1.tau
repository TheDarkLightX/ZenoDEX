# AB Reserve-State Child-Frontier Generation N8 Sample Scope Certificate v1
#
# PURPOSE:
#   Admit a research-only certificate for sampled n=8 AB strict zero-min
#   reserve-state child-frontier generation. The host checks the JSON report,
#   sampled scope, sample plan, generation counts, predecessor transition
#   counts, equality cleanliness, digest pins, deterministic replay, mutation
#   controls, Lean projection declaration, normalized source hash, and
#   no-authority rail. Tau only composes those host facts into a fail-closed
#   envelope.
#
# Stream mapping:
# i1  = certificate_active
# i2  = source_report_ok
# i3  = sampled_n8_zero_min_scope_ok
# i4  = sample_plan_pinned
# i5  = frontier_counts_ok
# i6  = predecessor_counts_ok
# i7  = state_counts_ok
# i8  = generation_clean
# i9  = frontier_rows_digest_pinned
# i10 = deterministic_replay_ok
# i11 = negative_controls_reject
# i12 = lean_contract_pinned
# i13 = authority_boundary_ok
# i14 = no_authority_effect
# i15 = corpus_nonvacuous
# i16 = normalized_source_hash_pinned
# i17 = hash_normalization_declared
#
# o1 = scope_ok
# o2 = generation_counts_ok
# o3 = transition_projection_ok
# o4 = digest_pins_ok
# o5 = replay_and_refutation_ok
# o6 = authority_boundary_ok
# o7 = generation_n8_sample_certificate_ok
# o8 = inactive_safe
# o9 = source_pin_ok

set charvar off

is1(x : sbf) := (x = 1:sbf).
scope_ok(source_report : sbf, sampled_n8_zero_min : sbf, sample_plan : sbf, nonvacuous : sbf, source_hash : sbf, normalization_declared : sbf) := is1(source_report) && is1(sampled_n8_zero_min) && is1(sample_plan) && is1(nonvacuous) && is1(source_hash) && is1(normalization_declared).
generation_counts_ok(frontier_counts : sbf, state_counts : sbf, generation_clean : sbf) := is1(frontier_counts) && is1(state_counts) && is1(generation_clean).
transition_projection_ok(predecessor_counts : sbf, lean_contract : sbf) := is1(predecessor_counts) && is1(lean_contract).
digest_pins_ok(frontier_digest : sbf) := is1(frontier_digest).
replay_and_refutation_ok(deterministic_replay : sbf, negative_controls : sbf) := is1(deterministic_replay) && is1(negative_controls).
authority_ok(boundary : sbf, no_authority : sbf) := is1(boundary) && is1(no_authority).
certificate_ok(active : sbf, source_report : sbf, sampled_n8_zero_min : sbf, sample_plan : sbf, frontier_counts : sbf, predecessor_counts : sbf, state_counts : sbf, generation_clean : sbf, frontier_digest : sbf, deterministic_replay : sbf, negative_controls : sbf, lean_contract : sbf, boundary : sbf, no_authority : sbf, nonvacuous : sbf, source_hash : sbf, normalization_declared : sbf) := is1(active) && scope_ok(source_report, sampled_n8_zero_min, sample_plan, nonvacuous, source_hash, normalization_declared) && generation_counts_ok(frontier_counts, state_counts, generation_clean) && transition_projection_ok(predecessor_counts, lean_contract) && digest_pins_ok(frontier_digest) && replay_and_refutation_ok(deterministic_replay, negative_controls) && authority_ok(boundary, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> scope_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i15[t]:sbf, i16[t]:sbf, i17[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> generation_counts_ok(i5[t]:sbf, i7[t]:sbf, i8[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> transition_projection_ok(i6[t]:sbf, i12[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> digest_pins_ok(i9[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> replay_and_refutation_ok(i10[t]:sbf, i11[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> authority_ok(i13[t]:sbf, i14[t]:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf, i15[t]:sbf, i16[t]:sbf, i17[t]:sbf)) &&
  (o8[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i14[t]:sbf))) &&
  (o9[t]:sbf = 1:sbf <-> is1(i16[t]:sbf)).
