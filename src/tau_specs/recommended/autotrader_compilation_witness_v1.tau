# Auto-trader compilation witness v1
#
# Purpose: validate the trusted source-artifact -> StrategyIR witness carried by
# the compile pipeline. This does not trust the raw text parser. It only trusts
# a canonical source artifact and checks that the compiled StrategyIR matches it
# exactly under the bounded strategy schema.
#
# i1  = source_form_ok         (sbf)
# i2  = strategy_hash_match    (sbf)
# i3  = owner_match            (sbf)
# i4  = backend_match          (sbf)
# i5  = template_match         (sbf)
# i6  = asset_universe_match   (sbf)
# i7  = allowed_actions_match  (sbf)
# i8  = notional_caps_match    (sbf)
# i9  = risk_limits_match      (sbf)
# i10 = strategy_window_match  (sbf)
# i11 = controls_match         (sbf)
# i12 = template_params_match  (sbf)
# i13 = tau_policy_specs_match (sbf)
# i14 = compile_contract_ok    (sbf)
#
# o1 = compilation_witness_ok

set charvar off

always
  (
    o1[t]:sbf = 1:sbf <->
    (
      (i1[t]:sbf = 1:sbf) &&
      (i2[t]:sbf = 1:sbf) &&
      (i3[t]:sbf = 1:sbf) &&
      (i4[t]:sbf = 1:sbf) &&
      (i5[t]:sbf = 1:sbf) &&
      (i6[t]:sbf = 1:sbf) &&
      (i7[t]:sbf = 1:sbf) &&
      (i8[t]:sbf = 1:sbf) &&
      (i9[t]:sbf = 1:sbf) &&
      (i10[t]:sbf = 1:sbf) &&
      (i11[t]:sbf = 1:sbf) &&
      (i12[t]:sbf = 1:sbf) &&
      (i13[t]:sbf = 1:sbf) &&
      (i14[t]:sbf = 1:sbf)
    )
  ).
