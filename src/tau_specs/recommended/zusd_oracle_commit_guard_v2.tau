# zUSD Oracle Commit Guard v2 (range-robust, flag-driven)
# i1 = oracle_seen (sbf)
# i2 = pending_le_active (sbf)
# i3 = fresh_ok (sbf)
# i4 = auth_ok (sbf)
# i5 = mcr_ok_at_pending (sbf)
# o4 = oracle_commit_allowed

set charvar off

env_ok(oracle_seen : sbf, pending_le_active : sbf, fresh_ok : sbf) := (oracle_seen = 1:sbf) && (pending_le_active = 1:sbf) && (fresh_ok = 1:sbf).
policy_ok(auth_ok : sbf, mcr_ok_at_pending : sbf) := (auth_ok = 1:sbf) && (mcr_ok_at_pending = 1:sbf).
oracle_commit_ok(oracle_seen : sbf, pending_le_active : sbf, fresh_ok : sbf, auth_ok : sbf, mcr_ok_at_pending : sbf) := env_ok(oracle_seen, pending_le_active, fresh_ok) && policy_ok(auth_ok, mcr_ok_at_pending).
always (o1[t]:sbf = 1:sbf <-> env_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf)) && (o2[t]:sbf = 1:sbf <-> policy_ok(i4[t]:sbf, i5[t]:sbf)) && (o3[t]:sbf = 1:sbf <-> policy_ok(i4[t]:sbf, i5[t]:sbf)) && (o4[t]:sbf = 1:sbf <-> oracle_commit_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf)).
