# Auto-trader compile contract v1
#
# Purpose: validate the carried compile-admission bundle for a bounded
# StrategyIR. The raw field logic stays in the ESSO compile-contract kernel;
# Tau checks the replayable subcheck bundle that the public compile CLI emits.
#
# i1  = backend_ok          (sbf)
# i2  = template_ok         (sbf)
# i3  = strategy_id_ok      (sbf)
# i4  = owner_binding_ok    (sbf)
# i5  = asset_scope_ok      (sbf)
# i6  = required_params_ok  (sbf)
# i7  = action_scope_ok     (sbf)
# i8  = notional_chain_ok   (sbf)
# i9  = slippage_ok         (sbf)
# i10 = oracle_window_ok    (sbf)
# i11 = strategy_window_ok  (sbf)
# i12 = controls_ok         (sbf)
# i13 = tau_bundle_ok       (sbf)
#
# o1 = compile_ok

set charvar off

always
  (
    o1[t]:sbf = 1:sbf <->
    (
      (i1[t]:sbf = 1:sbf) &&
      (i2[t]:sbf = 1:sbf) &&
      (i3[t]:sbf = 1:sbf) &&
      (i4[t]:sbf = 1:sbf) &&
      (i5[t]:sbf = 1:sbf) &&
      (i6[t]:sbf = 1:sbf) &&
      (i7[t]:sbf = 1:sbf) &&
      (i8[t]:sbf = 1:sbf) &&
      (i9[t]:sbf = 1:sbf) &&
      (i10[t]:sbf = 1:sbf) &&
      (i11[t]:sbf = 1:sbf) &&
      (i12[t]:sbf = 1:sbf) &&
      (i13[t]:sbf = 1:sbf)
    )
  ).
