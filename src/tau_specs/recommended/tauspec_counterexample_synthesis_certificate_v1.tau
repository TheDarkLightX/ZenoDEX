# TauSpec Counterexample Synthesis Certificate v1
#
# PURPOSE:
#   Admit a generated Tau-spec candidate only after host replay shows that the
#   candidate survived bounded grammar generation, parsing, semantic-contract
#   linting, host-projection boundary checks, positive traces, negative traces,
#   mutation rejection, value/profile checks, AB/CoW work-item coverage, and
#   no-authority rails.
#
# Stream mapping:
# i1  = certificate_active
# i2  = generated_by_bounded_grammar
# i3  = parse_ok
# i4  = semantic_contract_lint_ok
# i5  = host_projection_boundary_ok
# i6  = positive_trace_replay_ok
# i7  = negative_trace_replay_ok
# i8  = mutation_rejected_ok
# i9  = baseline_value_or_new_coverage_ok
# i10 = performance_budget_ok
# i11 = advisory_model_only
# i12 = no_authority_effect
# i13 = work_item_1_ab_covered
# i14 = work_item_2_cow_covered
#
# o1 = static_surface_ok
# o2 = replay_surface_ok
# o3 = value_profile_ok
# o4 = work_item_coverage_ok
# o5 = authority_boundary_ok
# o6 = counterexample_synthesis_certificate_ok
# o7 = inactive_safe

set charvar off

is1(x : sbf) := (x = 1:sbf).
static_surface_ok(grammar_ok : sbf, parse_ok : sbf, lint_ok : sbf, host_boundary_ok : sbf) := is1(grammar_ok) && is1(parse_ok) && is1(lint_ok) && is1(host_boundary_ok).
replay_surface_ok(positive_ok : sbf, negative_ok : sbf, mutation_ok : sbf) := is1(positive_ok) && is1(negative_ok) && is1(mutation_ok).
value_profile_ok(value_ok : sbf, budget_ok : sbf) := is1(value_ok) && is1(budget_ok).
work_item_coverage_ok(ab_ok : sbf, cow_ok : sbf) := is1(ab_ok) && is1(cow_ok).
authority_boundary_ok(advisory_only : sbf, no_authority : sbf) := is1(advisory_only) && is1(no_authority).
synthesis_certificate_ok(active : sbf, grammar_ok : sbf, parse_ok : sbf, lint_ok : sbf, host_boundary_ok : sbf, positive_ok : sbf, negative_ok : sbf, mutation_ok : sbf, value_ok : sbf, budget_ok : sbf, advisory_only : sbf, no_authority : sbf, ab_ok : sbf, cow_ok : sbf) := is1(active) && static_surface_ok(grammar_ok, parse_ok, lint_ok, host_boundary_ok) && replay_surface_ok(positive_ok, negative_ok, mutation_ok) && value_profile_ok(value_ok, budget_ok) && work_item_coverage_ok(ab_ok, cow_ok) && authority_boundary_ok(advisory_only, no_authority).

always
  (o1[t]:sbf = 1:sbf <-> static_surface_ok(i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf)) &&
  (o2[t]:sbf = 1:sbf <-> replay_surface_ok(i6[t]:sbf, i7[t]:sbf, i8[t]:sbf)) &&
  (o3[t]:sbf = 1:sbf <-> value_profile_ok(i9[t]:sbf, i10[t]:sbf)) &&
  (o4[t]:sbf = 1:sbf <-> work_item_coverage_ok(i13[t]:sbf, i14[t]:sbf)) &&
  (o5[t]:sbf = 1:sbf <-> authority_boundary_ok(i11[t]:sbf, i12[t]:sbf)) &&
  (o6[t]:sbf = 1:sbf <-> synthesis_certificate_ok(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf, i5[t]:sbf, i6[t]:sbf, i7[t]:sbf, i8[t]:sbf, i9[t]:sbf, i10[t]:sbf, i11[t]:sbf, i12[t]:sbf, i13[t]:sbf, i14[t]:sbf)) &&
  (o7[t]:sbf = 1:sbf <-> (!is1(i1[t]:sbf) && is1(i12[t]:sbf))).
