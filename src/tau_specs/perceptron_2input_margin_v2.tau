# Tau-only 2-input perceptron experiment with explicit margin gating
#
# Fixed unsigned model:
#   activation = (x1 * w1) + (x2 * w2) + bias
#   class = step(activation >= threshold)
#
# Margin-gated acceptance:
# - positive claim is accepted only when activation >= threshold + min_margin
# - negative claim is accepted only when activation + min_margin < threshold
#
# Domain restriction:
# - x1, x2, w1, w2, bias, threshold, min_margin are bounded to 0..127
# - activation stays within bv[16] without wraparound
#
# Stream mapping:
# i1 = x1
# i2 = x2
# i3 = w1
# i4 = w2
# i5 = bias
# i6 = threshold
# i7 = class_claimed (sbf)
# i8 = min_margin
#
# Outputs:
# o1 = perceptron_margin_ok

set charvar off

always (o1[t]:sbf = 1:sbf <-> ((i1[t]:bv[16] <= { #x007F }:bv[16]) && (i2[t]:bv[16] <= { #x007F }:bv[16]) && (i3[t]:bv[16] <= { #x007F }:bv[16]) && (i4[t]:bv[16] <= { #x007F }:bv[16]) && (i5[t]:bv[16] <= { #x007F }:bv[16]) && (i6[t]:bv[16] <= { #x007F }:bv[16]) && (i8[t]:bv[16] <= { #x007F }:bv[16]) && ((((i1[t]:bv[16] * i3[t]:bv[16]) + (i2[t]:bv[16] * i4[t]:bv[16]) + i5[t]:bv[16]) >= (i6[t]:bv[16] + i8[t]:bv[16]) && i7[t]:sbf = 1:sbf) || ((((i1[t]:bv[16] * i3[t]:bv[16]) + (i2[t]:bv[16] * i4[t]:bv[16]) + i5[t]:bv[16]) + i8[t]:bv[16]) < i6[t]:bv[16] && i7[t]:sbf = 0:sbf)))).
