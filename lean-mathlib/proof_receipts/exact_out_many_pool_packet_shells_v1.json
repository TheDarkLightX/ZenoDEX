  "claims": [
    "The many-pool candidate-domain contract is a deterministic rebuild from eight explicit audit booleans.",
    "The domain contract accepts exactly when sortedness, budget, nonempty-domain, completeness, leg-bound, pool-id, containment, and candidate-count facts are all true.",
    "The oracle contract computes a canonical winner from the exact-out route certificate and records whether the runtime choice equals that winner.",
    "The canonical winner is in the candidate stream and is no worse than every stream candidate.",
    "A runtime choice matches the canonical winner exactly when it is in the emitted stream and key-minimal over the stream.",
    "The guarded quote packet emits a quote exactly when the runtime choice is canonical; otherwise it emits a mismatch error.",
    "The certified winner packet accepts exactly when the candidate-domain audit facts hold and the guarded quote proves emitted minimality.",
    "The combined packet can be read either as audited emitted minimality, audited domain plus runtime quote, or audited domain plus canonical-winner quote."
  ],
  "proof_method": [
    "Boolean conjunction normalization for domain-contract facts.",
    "Fold membership and dominance lemmas from the exact-out route certificate shell.",
    "Antisymmetry of the ranked exact-out key relation for canonical-winner equality.",
    "Case analysis over the runtimeMatchesCanonical guard bit.",
    "Composition of domain-contract equivalences with guarded-quote equivalences."
  ],
