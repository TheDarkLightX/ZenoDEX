{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zenodex/tau/behavior-atlas/v1",
  "title": "ZenoDEX Tau Behavior Atlas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_id",
    "spec_path",
    "contract_ref",
    "atlas_status",
    "proof_scope",
    "output_order",
    "regions",
    "partition_checks"
  ],
  "properties": {
    "schema": {
      "const": "zenodex/tau/behavior-atlas/v1"
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_path": {
      "type": "string",
      "pattern": "^src/tau_specs/.+\\.tau$"
    },
    "contract_ref": {
      "type": "string",
      "pattern": "^formal/tau/contracts/.+\\.json$"
    },
    "atlas_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "promoted"
      ]
    },
    "proof_scope": {
      "type": "string",
      "enum": [
        "bounded_assurance_domain",
        "full_input_domain"
      ]
    },
    "domain_hash": {
      "type": "string"
    },
    "output_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^o[0-9]+$"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "partition_checks": {
      "$ref": "#/$defs/partitionChecks"
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "output_vector",
        "reachability_status",
        "region_formula"
      ],
      "properties": {
        "region_id": {
          "type": "string"
        },
        "output_vector": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        },
        "reachability_status": {
          "type": "string",
          "enum": [
            "reachable",
            "unreachable",
            "open"
          ]
        },
        "region_formula": {
          "type": "string"
        },
        "witness_inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "proof_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "partitionChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disjointness",
        "exhaustiveness",
        "tau_differential",
        "interpreter_equivalence"
      ],
      "properties": {
        "disjointness": {
          "type": "string",
          "enum": [
            "pending",
            "proved",
            "failed"
          ]
        },
        "exhaustiveness": {
          "type": "string",
          "enum": [
            "pending",
            "proved",
            "failed"
          ]
        },
        "tau_differential": {
          "type": "string",
          "enum": [
            "pending",
            "proved",
            "failed"
          ]
        },
        "interpreter_equivalence": {
          "type": "string",
          "enum": [
            "pending",
            "proved",
            "failed"
          ]
        }
      }
    }
  }
}
