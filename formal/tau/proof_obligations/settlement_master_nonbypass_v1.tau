# CATEGORY: settlement-master non-bypass proof obligation
# CLAIM: the settlement master gate cannot admit an unbalanced settlement.
#
# Verification lane:
#   - latest Tau unsat command
#   - independent Z3 bit-vector check
#
# Runtime Tau's historical unsat command is not used as evidence here.
set charvar off

unsat ((ADM:sbf = (sreq:sbf & cons:sbf & fresh:sbf))
  && (ADM:sbf = 1:sbf)
  && ((cons:sbf = 1:sbf) <-> (
       ((a1:bv[32] + a2:bv[32] + a3:bv[32] + a4:bv[32]) <= t:bv[32])
    && ((a1:bv[32] + a2:bv[32] + a3:bv[32] + a4:bv[32]) >= t:bv[32])
  ))
  && ((a1:bv[32] + a2:bv[32] + a3:bv[32] + a4:bv[32]) != t:bv[32])).
