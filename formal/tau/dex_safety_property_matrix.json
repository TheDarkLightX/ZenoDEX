      "release_blocking": true,
      "status": "shadow_scaffolded",
      "intent": "Only the exact next sequential autotrader nonce may be accepted, and rejected nonce attempts must not advance state.",
      "tau_contract_id": "autotrader_nonce_guard_v1",
      "tau_spec_path": "src/tau_specs/recommended/autotrader_nonce_guard_v1.tau",
      "shadow_model": {
        "formalism": "tla",
        "module_path": "formal/tla/AutoTraderNonceGuardShadow.tla",
        "config_path": "formal/tla/AutoTraderNonceGuardShadow.cfg",
        "invariants": [
          "TypeOK",
          "AcceptedOnlySequential",
          "RejectedDoesNotAdvance",
          "NonceNeverDecreases"
        ]
      },
      "allowed_examples": [
        "next_nonce_accepts"
      ],
      "forbidden_examples": [
        "future_gap_rejects",
        "bad_expected_nonce_rejects"
