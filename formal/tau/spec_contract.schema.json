{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zenodex/tau/spec-contract/v1",
  "title": "ZenoDEX Tau Spec Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_id",
    "spec_path",
    "kind",
    "contract_status",
    "proof_scope",
    "input_domain",
    "outputs",
    "behavior_partition",
    "theorems"
  ],
  "properties": {
    "schema": {
      "const": "zenodex/tau/spec-contract/v1"
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_path": {
      "type": "string",
      "pattern": "^src/tau_specs/.+\\.tau$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "combinational_guard",
        "proof_gate",
        "certificate_guard",
        "bundle_or_composition",
        "stateful_policy_guard"
      ]
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "promoted"
      ]
    },
    "proof_scope": {
      "type": "string",
      "enum": [
        "bounded_assurance_domain",
        "full_input_domain"
      ]
    },
    "human_summary": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_domain": {
      "$ref": "#/$defs/inputDomain"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outputSpec"
      }
    },
    "behavior_partition": {
      "$ref": "#/$defs/behaviorPartition"
    },
    "theorems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/theorem"
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceLink"
      }
    }
  },
  "$defs": {
    "inputDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streams",
        "domain_model"
      ],
      "properties": {
        "streams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputStream"
          }
        },
        "domain_model": {
          "type": "string",
          "enum": [
            "total_bitvector_product",
            "bounded_explicit_enumeration",
            "externally_partitioned"
          ]
        },
        "intended_preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_partitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analysisPartition"
          }
        }
      }
    },
    "inputStream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^i[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "sbf",
            "bv16",
            "bv32",
            "bv64"
          ]
        },
        "role": {
          "type": "string"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "analysisPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "formula"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "formula": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        }
      }
    },
    "outputSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "meaning",
        "contract_formula",
        "contract_expr"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^o[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "sbf",
            "bv16",
            "bv32",
            "bv64"
          ]
        },
        "meaning": {
          "type": "string"
        },
        "contract_formula": {
          "type": "string"
        },
        "contract_expr": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "behaviorPartition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_basis",
        "coverage_goal",
        "reachable_vectors_must_be_witnessed",
        "unreachable_vectors_must_be_proved"
      ],
      "properties": {
        "partition_basis": {
          "type": "string",
          "enum": [
            "output_vector",
            "named_regions"
          ]
        },
        "coverage_goal": {
          "type": "string",
          "enum": [
            "exact",
            "promotion_gate"
          ]
        },
        "reachable_vectors_must_be_witnessed": {
          "type": "boolean"
        },
        "unreachable_vectors_must_be_proved": {
          "type": "boolean"
        }
      }
    },
    "theorem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "preferred_mechanization"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "soundness",
            "completeness",
            "exactness",
            "reachability",
            "unreachability",
            "partition_disjointness",
            "partition_exhaustiveness",
            "interpreter_equivalence"
          ]
        },
        "statement": {
          "type": "string"
        },
        "preferred_mechanization": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "smt_bitvector_exact",
              "lean_rechecked",
              "tau_differential_exec",
              "manual_review"
            ]
          }
        }
      }
    },
    "evidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
