{
  "schema": "zenodex.consensus_semantic_contract.v1",
  "contract_id": "zenodex_consensus_semantics_v1",
  "claim_levels": {
    "core_equivalent": "Guest or port matches the Python core transition under already-admitted inputs.",
    "modeled_envelope_equivalent": "Guest or port matches Python under a harness-modeled envelope; this is not a live admission claim.",
    "live_replay_authority_equivalent": "Guest or port matches the live Python REPLAY authority (replay_guard.admit -- the strict-sequential policy the chain enforces via tx_sequence) plus the core transition. Bound to that authority/model, NOT to driving the deployed node; strictly weaker than live_equivalent.",
    "live_equivalent": "Guest or port matches actual live transaction admission (the deployed node) plus the core transition."
  },
  "authority_order": [
    "live_consensus_authority_path",
    "operation_semantic_contract",
    "proof_guest_or_port",
    "differential_harness",
    "docs_or_evidence_notes"
  ],
  "operations": {
    "perps_np.deposit_collateral": {
      "core": {
        "live_authority_ref": "src/core/perp_np_clearinghouse.py::deposit",
        "amount_domain": "amount_e8 >= 0",
        "zero_amount_behavior": "account_join_no_collateral_delta",
        "negative_amount_behavior": "reject_no_mutation",
        "nonce_layer": "tx_envelope",
        "core_nonce_effect": "unchanged",
        "collateral_effect": "collateral_e8 += amount_e8",
        "net_deposited_effect": "net_deposited_e8 += amount_e8"
      },
      "envelope": {
        "live_binding_status": "bound_to_replay_guard",
        "sender_authorization_layer": "tx_envelope",
        "replay_protection_layer": "tx_envelope",
        "duplicate_envelope_behavior": "reject_before_core_mutation",
        "closed_obligation_id": "P0-3b",
        "chain_replay_layer": {
          "enforced_at": "tau_node_tx_sequence",
          "evidence": [
            "src/integration/perps_wallet_api.py:2764",
            "src/integration/perps_wallet_api.py:2885-2889"
          ],
          "python_authority_model": "src/core/replay_guard.py::admit",
          "policy": "strict_sequential_per_sender_no_gaps",
          "note": "Live deposit/withdraw replay is enforced at the tau-node tx_sequence layer (fail-closed, generic over ops), modeled in Python by replay_guard.admit. The guest (zk/state_proof_risc0/shared/src/surfaces.rs) and the differential are bound to that strict-sequential policy (1..=U32_MAX, no gaps). The claim is therefore live_replay_authority_equivalent -- scoped to this replay authority/model, NOT to literally driving the deployed node."
        }
      },
      "guest": {
        "differential_ref": "tools/runtime/perps_np_guest_differential.py",
        "collateral_binding_layer": "witness_or_input_envelope",
        "envelope_binding": "live_replay_guard_admit_strict_sequential",
        "live_equivalence_claim_level": "live_replay_authority_equivalent"
      }
    },
    "clob.place_limit_order": {
      "core": {
        "live_authority_ref": "src/core/clob_matching.py::apply_order",
        "book_root_ref": "src/state/clob_book.py::ClobBook.state_root",
        "scope": "single incoming CLOB order after API admission/enrichment",
        "claim_level": "core_equivalent"
      },
      "api": {
        "live_authority_ref": "src/integration/orderbook_api.py::handle_orderbook_request",
        "stage": "stage0_in_memory_non_persistent",
        "proof_invocation": "none_stage0",
        "status_on_accept": "executed",
        "proof_status_on_accept": "proof_pending",
        "latest_proven_height_on_accept": null,
        "cryptographic_signature_verification": "not_implemented_shape_only"
      },
      "guest": {
        "proof_type": "risc0.zenodex_clob_transition.v1",
        "guest_dispatch_ref": "zk/state_proof_risc0/methods/guest/src/main.rs",
        "shared_kernel_ref": "zk/state_proof_risc0/shared/src/clob.rs::execute_clob_transition_v1",
        "matching_core_ref": "src/core/clob_matching.py::apply_order",
        "live_equivalence_claim_level": "core_equivalent",
        "deployed_api_admission_binding_status": "not_bound_stage0_api_does_not_invoke_guest",
        "strongest_allowed_claim": "core_equivalent",
        "note": "The RISC0 CLOB guest proves the matching/book-root transition for already-admitted inputs. The deployed Stage-0 orderbook API applies src.core.clob_matching.apply_order directly and labels responses proof_pending; it does not invoke or require the guest proof."
      }
    }
  },
  "bdd": {
    "feature_files": [
      "docs/semantics/perps_np_deposit_collateral.feature",
      "docs/semantics/clob_orderbook_guest.feature"
    ],
    "required_scenarios": {
      "perps_np.deposit_collateral.core.zero_deposit_joins_account": {
        "layer": "core",
        "status": "executable"
      },
      "perps_np.deposit_collateral.core.deposit_does_not_consume_nonce": {
        "layer": "core",
        "status": "executable"
      },
      "perps_np.deposit_collateral.core.negative_rejects_without_mutation": {
        "layer": "core",
        "status": "executable"
      },
      "perps_np.deposit_collateral.guest.claim_scoped_to_live_replay_authority": {
        "layer": "guest_differential",
        "status": "executable"
      },
      "perps_np.deposit_collateral.envelope.duplicate_tx_rejects_before_core": {
        "layer": "tx_envelope",
        "status": "executable"
      },
      "clob.place_limit_order.guest.claim_scoped_to_matching_core": {
        "layer": "guest_differential",
        "status": "executable"
      }
    }
  },
  "overclaim_guards": [
    {
      "path": "tools/runtime/perps_np_guest_differential.py",
      "forbidden_tokens": [
        "verified 1:1",
        "production 1:1",
        "live_equivalent"
      ],
      "required_tokens": [
        "replay_guard",
        "strict-sequential",
        "chain tx_sequence"
      ]
    },
    {
      "path": "src/integration/orderbook_api.py",
      "forbidden_tokens": [
        "ProofStatus.PROOF_VERIFIED.value"
      ],
      "required_tokens": [
        "No proof",
        "proof_pending",
        "latest_proven_height",
        "Stage 0"
      ]
    }
  ]
}
