# ZRPF retained-receipt guest kernel delta for the pinned Amazon Linux 6.1.174
# microVM kernel. Apply after Firecracker's exact x86_64 6.1 and ci.config
# inputs, then run `make olddefconfig` and hash the complete resolved .config.

CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BINFMT_ELF=y
CONFIG_SECCOMP=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_BUILD_SALT=""
CONFIG_LOCALVERSION=""
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# The guest has only read-only root/input block devices and one bounded raw
# output block device. Network, modules, snapshots, debugging, and general
# extension surfaces are outside this profile.
# CONFIG_MODULES is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_X86_MPPARSE is not set
# CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_VIRTIO_VSOCKETS is not set
# CONFIG_HW_RANDOM_VIRTIO is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_NET is not set
# Linux 6.1 makes CONFIG_SECCOMP_FILTER depend on CONFIG_NET. This profile
# keeps the smaller no-network guest surface and does not claim an in-guest
# seccomp filter. The Firecracker and jailer host filters remain separate.
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USER_NS is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_GCC_PLUGIN_RANDSTRUCT is not set
# CONFIG_SQUASHFS_XATTR is not set
