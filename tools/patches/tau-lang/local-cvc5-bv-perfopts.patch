 	// configure the solver
 	solver.setOption("produce-models", "true");
 	//solver.setOption("incremental", "true");
-	solver.setLogic("BV");
+	// Allow overriding the logic for BV experiments (e.g. QF_BV for eager bitblasting).
+	if (const char* logic = std::getenv("TAU_CVC5_BV_LOGIC"); logic && *logic) {
+		try {
+			solver.setLogic(std::string(logic));
+		} catch (const cvc5::CVC5ApiException&) {
+			solver.setLogic("BV");
+		}
+	} else {
+		solver.setLogic("BV");
+	}
+	// Determinism hygiene: pin cvc5 RNG seeds unless overridden by env opts.
+	// (Some BV pipelines can otherwise exhibit large runtime variance.)
+	try {
+		solver.setOption("random-seed", "0");
+		solver.setOption("sat-random-seed", "0");
+		// Performance posture: enable bit-vector propagation in the bit-blaster.
+		// Empirically improves our Tau DEX guard workload.
+		solver.setOption("bv-propagate", "true");
+	} catch (const cvc5::CVC5ApiException&) {
+		// Best-effort: older/newer cvc5 versions may rename options.
+	}
+
+	// Experiment hook: allow tuning cvc5's BV pipeline without recompiling.
+	//
+	// Example:
+	//   TAU_CVC5_BV_OPTS='bitblast=eager,bv-solver=bitblast-internal'
+	//
+	// IMPORTANT:
+	// - Invalid options are ignored (fail-open) to keep Tau usable across cvc5 versions.
+	// - Intended for local benchmarking/experimentation only.
+	if (const char* raw = std::getenv("TAU_CVC5_BV_OPTS"); raw && *raw) {
+		std::string s(raw);
+		size_t i = 0;
+		auto trim = [](std::string_view v) -> std::string_view {
+			while (!v.empty() && (v.front() == ' ' || v.front() == '\t' || v.front() == '\n')) v.remove_prefix(1);
+			while (!v.empty() && (v.back() == ' ' || v.back() == '\t' || v.back() == '\n')) v.remove_suffix(1);
+			return v;
+		};
+
+		while (i < s.size()) {
+			// Split on ',' or ';'
+			size_t j = i;
+			while (j < s.size() && s[j] != ',' && s[j] != ';') j++;
+			std::string_view token(s.data() + i, j - i);
+			token = trim(token);
+			i = (j < s.size()) ? (j + 1) : j;
+			if (token.empty()) continue;
+
+			size_t eq = token.find('=');
+			if (eq == std::string_view::npos) continue;
+			std::string_view key = trim(token.substr(0, eq));
+			std::string_view val = trim(token.substr(eq + 1));
+			if (key.empty() || val.empty()) continue;
+
+			try {
+				solver.setOption(std::string(key), std::string(val));
+			} catch (const cvc5::CVC5ApiException&) {
+				// Ignore unknown/invalid options for portability.
+			}
+		}
+	}
 }
 
