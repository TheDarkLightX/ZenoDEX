# Re-exclude generated host artifacts after the broad src/UI negations above.
# Otherwise Docker can copy stale bytecode for deleted runtime modules or a
# developer's node_modules/dist over the clean build-stage installation.
**/__pycache__/
**/*.py[cod]
tools/dex-ui/node_modules/
tools/dex-ui/dist/
