{
  "schema": "zenodex/test-hygiene-evidence/v1",
  "evidence_id": "THV1-20260806-lifecycle-route-resolver-v1",
  "created_date": "2026-08-06",
  "claim_scope": "The lifecycle route resolver removes caller-proposed route authority from state binding by deriving one exact governed route from the command variant, profile-bound route and module registries, lifecycle-purpose metadata, and state-authenticated consumed-object release pins; it grants no proof, economic-transition, settlement, or publication authority.",
  "change_kind": "behavior_change",
  "risk_class": "authority",
  "invariant_ids": [
    "LRR-V1-LIFECYCLE-PURPOSE-IDENTITY-BOUND",
    "LRR-V1-PURPOSE-STATUS-ADMISSION",
    "LRR-V1-EXACT-COMMAND-VARIANT",
    "LRR-V1-STATE-AUTHENTICATED-RELEASE-PINS",
    "LRR-V1-ONE-RELEASE-PER-PINNED-LANE",
    "LRR-V1-ALL-PINNED-LANES-COVERED",
    "LRR-V1-UNIQUE-ROUTE-OR-REJECT",
    "LRR-V1-PROPOSED-ROUTE-EQUALITY",
    "LRR-V1-REJECT-PRODUCES-NO-AUTHORITY"
  ],
  "failure_modes": [
    "a caller selects a drain route without consuming an object created by its exact release",
    "a caller substitutes an active route for an old pinned object or a drain route for an active command",
    "two objects in one lane authenticate conflicting creating releases",
    "a route omits a lane present in authenticated object pins",
    "zero or multiple routes satisfy the command and lifecycle constraints",
    "an active-new dependency names a release that cannot create new objects",
    "a pinned-existing dependency names a release that cannot transition existing objects",
    "lifecycle-purpose bytes are omitted from route identity or an unknown discriminant decodes",
    "route, registry, profile, or occurrence fixed vectors retain stale pre-purpose identities",
    "a new resolver source or test escapes the exact ZRPF source closure"
  ],
