  "evidence_id": "THV1-20260831-immutable-intent-consumer-closure",
  "created_date": "2026-08-31",
  "claim_scope": "Immutable Intent snapshots expose explicit detached JSON projections at exact consumer boundaries; pool-curve, Oracle, proof-signing, support-root, and blast-radius consumers preserve their prior semantics without reintroducing mutable aliases.",
  "change_kind": "bug_fix",
  "risk_class": "critical",
  "invariant_ids": [
    "INTENT-V1-TRANSITIVE-IMMUTABILITY",
    "INTENT-V1-DETACHED-COMPOSITE-PROJECTION",
    "POOL-CURVE-V1-IMMUTABLE-INTENT-REFINEMENT",
    "ORACLE-ROUTING-V1-HASHED-QUERY-IDENTITY",
    "ACCEPTANCE-TCB-V1-EXACT-SIGNING-PROJECTION"
  ],
  "failure_modes": [
    "a recursively frozen curve_params object is rejected by an exact plain-dict curve decoder",
    "support derivation omits an in-batch non-CPMM pool because its immutable curve parameters cannot be normalized",
    "a protected-swap Oracle authorization is rejected before typed verification because the consumer passes a frozen nested mapping",
    "a human-readable routing query identity violates the economic-envelope SHA-256 identity contract",
    "proof commitment JSON retains a private frozen Intent mapping",
    "diagnostic blast-radius logic silently misses nonce and quote-receipt fields on immutable snapshots",
    "legacy tests mutate an admitted Intent after construction and thereby test an impossible state",
    "the stateful quote-receipt explorer calls the removed mutable Intent API and never reaches its intended stale-receipt paths"
  ],
