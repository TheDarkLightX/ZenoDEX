  "aaa": {
    "status": "applied",
    "reason": "Given explicitly governed fixture registries, a V2 body and signed intent, prepare the exact message and verify a sequenced occurrence. Independent canonical expected bytes and py_ecc signatures observe the selected schema, original owned inputs, exact request bytes and deterministic failure. The forged-registry case independently proves Mallory can sign its proposed message before checking that ungoverned authority rejects before artifact access."
  },
  "reject_is_noop": {
    "status": "applied",
    "reason": "Invalid authorization and occurrence inputs cannot acquire the artifact. Signature and transport failures cannot return success. The API owns no economic, replay, history or outbox writer and returns no reusable witness; repeated checks reacquire verification and respect revocation."
  },
