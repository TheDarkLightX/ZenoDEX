+"""NativeVerifier executes a sealed snapshot of exactly the pinned verifier bytes.
+
+The child scripts below are synthetic transport controls, not cryptographic
+verifiers. They only decide whether a forged "verified" response reaches the
+adapter.
+"""
+import errno
+import itertools
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from hashlib import sha256
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT/'adapters/python')]
+from taufold_adapters import verifier
+from taufold_adapters.context import BoundRequest, Invocation
+from taufold_adapters.verifier import (
+    Evidence,
+    NativeVerifier,
+    VerificationRejected,
+)
+
+REAL_RUN = subprocess.run
+REAL_POPEN = subprocess.Popen
+REJECTING = f'#!{sys.executable}\nimport sys\nsys.stdin.buffer.read()\nsys.exit(1)\n'.encode()
+ACCEPTING = (f'#!{sys.executable}\nimport json, sys\nr = json.load(sys.stdin)\n'
+             "print(json.dumps({'status': 'verified', 'output': OUTPUT, 'public_memory': [], 'steps': 1,"
+             " 'guest_image_id': [0] * 8, 'input_commitment': r['expected_input_commitment'],"
+             " 'program_sha256': [1] * 32, 'specification_sha256': [3] * 32, 'receipt_sha256': [2] * 32},"
+             " separators=(',', ':')))\n")
+HONEST = ACCEPTING.replace('OUTPUT', '0').encode()
+FORGER = ACCEPTING.replace('OUTPUT', '7').encode()
+
+
+def bound_request():
+    invocation = Invocation('demo', 'snapshot-test', b'\1' * 32, b'\2' * 32, b'\3' * 32, 0)
+    request = object.__new__(BoundRequest)  # transport control; rule validation is out of scope here
+    fields = {'app': 'demo', 'public_json': b'{}', 'invocation': invocation, 'input_commitment': b'\4' * 32}
+    for name, value in fields.items():
+        object.__setattr__(request, name, value)
+    return request
+
+
+def open_fds():
+    return set(os.listdir('/proc/self/fd'))
+
+
+@unittest.skipUnless(sys.platform.startswith('linux'), 'sealed memfd execution is Linux-only')
+class NativeVerifierSnapshotTest(unittest.TestCase):
+    def setUp(self):
+        self.fds = open_fds()
+        self.tmp = tempfile.TemporaryDirectory(dir=Path(__file__).parent)
+        self.path = Path(self.tmp.name) / 'verifier'
+        self.request = bound_request()
+
+    def tearDown(self):
+        self.tmp.cleanup()
+        self.assertEqual(open_fds(), self.fds, 'owned descriptors leaked')
+
+    def install(self, content, path=None):
+        path = path or self.path
+        path.write_bytes(content)
+        path.chmod(0o755)
+        return path
+
+    def replace_path(self, spawn, *args, **kwargs):
+        os.replace(self.install(FORGER, self.path.with_name('forger')), self.path)
+        return spawn(*args, **kwargs)
+
+    def mutate_in_place(self, spawn, *args, **kwargs):
+        with open(self.path, 'r+b') as handle:  # same inode, new contents
+            handle.write(FORGER)
+            handle.truncate()
+        return spawn(*args, **kwargs)
+
+    def admits(self, result):
+        value = json.loads(result.stdout) if result.returncode == 0 else {}
+        return value.get('status') == 'verified'
+
+    def test_old_hash_then_exec_admits_forgery_after_measurement(self):
+        for mutate in (self.replace_path, self.mutate_in_place):
+            with self.subTest(mutate=mutate.__name__):
+                pin = sha256(self.install(REJECTING).read_bytes()).digest()
+                self.assertEqual(sha256(self.path.read_bytes()).digest(), pin)  # legacy measurement
+                try:
+                    legacy = mutate(REAL_RUN, [str(self.path)], input=b'{"expected_input_commitment":[]}',
+                                    capture_output=True, timeout=60)
+                except PermissionError:
+                    self.skipTest('temporary directory does not permit path execution')
+                self.assertTrue(self.admits(legacy), 'control: mutable path runs the forger')
+
+    def test_path_replacement_and_in_place_mutation_run_the_sealed_snapshot(self):
+        for mutate in (self.replace_path, self.mutate_in_place):
+            with self.subTest(mutate=mutate.__name__):
+                native = NativeVerifier(self.install(REJECTING), sha256(REJECTING).digest())
+                with mock.patch.object(verifier.subprocess, 'Popen',
+                                       side_effect=lambda *a, mutate=mutate, **k: mutate(REAL_POPEN, *a, **k)) as popen, \
+                        self.assertRaises(VerificationRejected):
+                    native.verify(self.request, b'counterfeit')
+                self.assertEqual(popen.call_count, 1)
+                self.assertEqual(self.path.read_bytes(), FORGER)
+
+    def test_honest_snapshot_executes_through_proc_fd_with_output_zero(self):
+        native = NativeVerifier(self.install(HONEST), sha256(HONEST).digest())
+        seen = []
+        real_exchange = verifier._process.exchange
+
+        def exchange(args, payload, **kwargs):
+            self.assertEqual((kwargs['seconds'], kwargs['limit']), (60, 65536))
