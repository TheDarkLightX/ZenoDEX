@@ -0,0 +1,139 @@
+"""Bounded, deadlock-free request/response exchange with one trusted child process.
+
+The kernel, process machinery, dynamic loader and libraries are trusted. Every
+rejection kills the child's process group, reaps the child and closes every
+stream and descriptor. Rejection messages are fixed and never quote child output.
+"""
+from __future__ import annotations
+
+import math
+import os
+import select
+import signal
+import subprocess
+import time
+from contextlib import suppress
+
+_clock = time.monotonic  # replaced by deterministic tests
+_CHUNK = 1 << 16
+
+
+class ChildRejected(Exception):
+    """The child did not complete a clean, bounded exchange."""
+
+
+def _supported():
+    return (hasattr(os, 'pidfd_open') and hasattr(os, 'set_blocking') and hasattr(os, 'killpg')
+            and hasattr(select, 'poll') and hasattr(signal, 'pidfd_send_signal'))
+
+
+def _read(descriptor, size):
+    """Return bytes, b'' at end of stream, or None when nothing is ready."""
+    try:
+        return os.read(descriptor, size)
+    except BlockingIOError:
+        return None
+
+
+def exchange(args, request, *, pass_fds, seconds, limit):
+    """Deliver all of request, then return at most limit bytes of stdout.
+
+    Rejects timeouts, undelivered requests, any stderr byte, oversized stdout
+    and any exit other than status zero.
+    """
+    if not _supported():
+        raise ChildRejected('bounded verifier execution is unsupported on this platform')
+    process = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                               bufsize=0, pass_fds=pass_fds, start_new_session=True)
+    pidfd = -1
+    try:
+        deadline = _clock() + seconds
+        pidfd = os.pidfd_open(process.pid)
+        output = _collect(process, pidfd, memoryview(request), deadline, limit)
+    finally:
+        _reap(process, pidfd)
+    if process.returncode != 0:
+        raise ChildRejected('verifier exited unsuccessfully')
+    return output
+
+
+def _collect(process, pidfd, request, deadline, limit):
+    stdin, stdout, stderr = process.stdin.fileno(), process.stdout.fileno(), process.stderr.fileno()
+    for descriptor in (stdin, stdout, stderr):
+        os.set_blocking(descriptor, False)
+    poller = select.poll()
+    for descriptor in (stdout, stderr, pidfd):
+        poller.register(descriptor, select.POLLIN)
+    readers, output, written = {stdout, stderr}, bytearray(), 0
+
+    def finish_request():
+        poller.unregister(stdin)
+        process.stdin.close()
+
+    def receive(descriptor):
+        """Consume one ready chunk; return False once nothing more is ready."""
+        if descriptor == stderr:
+            chunk = _read(stderr, 1)
+            if chunk:
+                raise ChildRejected('verifier wrote diagnostics')
+        else:
+            chunk = _read(stdout, limit + 1 - len(output))
+            if chunk:
+                output.extend(chunk)
+                if len(output) > limit:
+                    raise ChildRejected('verifier response exceeds its size limit')
+        if chunk == b'':
+            poller.unregister(descriptor)
+            readers.discard(descriptor)
+        return bool(chunk)
+
+    if request:
+        poller.register(stdin, select.POLLOUT)
+    else:
+        process.stdin.close()
+    exited = False
+    while not exited:
+        remaining = deadline - _clock()
+        if remaining <= 0:
+            raise ChildRejected('verifier exceeded its lifetime')
+        events = poller.poll(math.ceil(remaining * 1000))
+        if _clock() >= deadline:
+            raise ChildRejected('verifier exceeded its lifetime')
+        for descriptor, _ in events:
+            if descriptor == pidfd:
+                exited = True
+            elif descriptor == stdin and not process.stdin.closed:
+                try:
+                    written += os.write(stdin, request[written:written + _CHUNK])
+                except BlockingIOError:
+                    continue
+                except BrokenPipeError:
+                    raise ChildRejected('verifier exited before reading the request') from None
+                if written == len(request):
+                    finish_request()
+            elif descriptor in readers:
+                receive(descriptor)
+    if not process.stdin.closed:
+        raise ChildRejected('verifier exited before reading the request')
+    # The child has exited, so everything it wrote is already buffered.
+    for descriptor in (stderr, stdout):
+        while descriptor in readers and receive(descriptor):
+            pass
+    if _clock() >= deadline:
+        raise ChildRejected('verifier exceeded its lifetime')
+    return bytes(output)
+
+
+def _reap(process, pidfd):
+    if process.returncode is None:
+        if pidfd >= 0:
+            with suppress(OSError):
+                signal.pidfd_send_signal(pidfd, signal.SIGKILL)
+        with suppress(OSError):
+            os.killpg(process.pid, signal.SIGKILL)
+        process.wait()
+    for stream in (process.stdin, process.stdout, process.stderr):
+        with suppress(OSError):
+            stream.close()
+    if pidfd >= 0:
+        os.close(pidfd)
