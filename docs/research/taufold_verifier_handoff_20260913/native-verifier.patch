+                with self.subTest(change=change.__name__):
+                    change()
+                    with self.assertRaises(VerificationRejected):
+                        native.verify(self.request, b'bundle')
+                    for leftover in (self.path, self.path.with_name('target')):
+                        if leftover.is_dir() and not leftover.is_symlink():
+                            leftover.rmdir()
+                        elif leftover.exists() or leftover.is_symlink():
+                            leftover.unlink()
+            run.assert_not_called()
+
+    def test_short_io_growth_and_unsupported_sealing_reject_without_execution(self):
+        native = NativeVerifier(self.install(HONEST), sha256(HONEST).digest())
+        real_readv, real_fcntl = os.readv, verifier.fcntl.fcntl
+
+        def short_read(descriptor, buffers):
+            short_read.calls += 1
+            return real_readv(descriptor, [buffers[0][:5]]) if short_read.calls == 1 else 0
+
+        def growing_read(descriptor, buffers):
+            with open(self.path, 'ab') as handle:
+                handle.write(b'#')
+            return real_readv(descriptor, buffers)
+
+        def unreported_seals(descriptor, command, *args):
+            return 0 if command == verifier.fcntl.F_GET_SEALS else real_fcntl(descriptor, command, *args)
+
+        failures = {
+            'short read': mock.patch.object(verifier.os, 'readv', side_effect=short_read),
+            'growth': mock.patch.object(verifier.os, 'readv', side_effect=growing_read),
+            'short write': mock.patch.object(verifier.os, 'write', return_value=0),
+            'write error': mock.patch.object(verifier.os, 'write', side_effect=OSError(errno.ENOSPC, 'full')),
+            'memfd unsupported': mock.patch.object(verifier.os, 'memfd_create', side_effect=OSError(errno.ENOSYS, 'no')),
+            'sealing unsupported': mock.patch.object(verifier.fcntl, 'fcntl', side_effect=OSError(errno.EINVAL, 'no')),
+            'seals unreported': mock.patch.object(verifier.fcntl, 'fcntl', side_effect=unreported_seals),
+            'no fcntl module': mock.patch.object(verifier, 'fcntl', None),
+        }
+        with mock.patch.object(verifier.subprocess, 'Popen') as run:
+            for name, failure in failures.items():
+                with self.subTest(failure=name):
+                    self.install(HONEST)
+                    short_read.calls = 0
+                    with failure, self.assertRaises(VerificationRejected):
+                        native.verify(self.request, b'bundle')
+            run.assert_not_called()
+
+    def test_execution_failure_rejects_and_closes_snapshot(self):
+        native = NativeVerifier(self.install(HONEST), sha256(HONEST).digest())
+        closed = []
+        real_close = os.close
+
+        def close(descriptor):
+            closed.append(descriptor)
+            real_close(descriptor)
+
+        for error in (PermissionError(errno.EACCES, 'noexec'), 'timeout'):
+            with self.subTest(error=error if error == 'timeout' else type(error).__name__):
+                closed.clear()
+                spawn = REAL_POPEN if error == 'timeout' else error
+                # Deterministic clock: the deadline is read at 0 s, every later check at 61 s.
+                clock = itertools.chain([0.0], itertools.repeat(61.0))
+                with mock.patch.object(verifier.subprocess, 'Popen', side_effect=spawn) as run, \
+                        mock.patch.object(verifier._process, '_clock', side_effect=clock), \
+                        mock.patch.object(verifier.os, 'close', side_effect=close), self.assertRaises(VerificationRejected):
+                    native.verify(self.request, b'bundle')
+                self.assertIn(run.call_args.kwargs['pass_fds'][0], closed)
+
+
+if __name__ == '__main__':
+    unittest.main()
