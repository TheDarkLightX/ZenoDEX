+"""Bounded child I/O and total response parsing for NativeVerifier.
+
+TRANSPORT-ONLY: every child program below is a synthetic Python script. None
+is a cryptographic verifier and nothing here is real proof evidence; the tests
+only decide how the adapter transports a request and admits a response.
+"""
+import dataclasses
+import os
+import signal
+import sys
+import tempfile
+import unittest
+from hashlib import sha256
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT/'adapters/python'), str(ROOT/'tests')]
+from taufold_adapters import verifier
+from taufold_adapters.verifier import (
+    Evidence,
+    NativeVerifier,
+    VerificationRejected,
+)
+from test_native_verifier_snapshot import (
+    FORGER,
+    REAL_POPEN,
+    bound_request,
+    open_fds,
+)
+
+
+def words(*values):
+    return b'[' + b','.join(str(value).encode() for value in values) + b']'
+
+
+# Fixed expected values, written out independently of the implementation.
+IMAGE = words(759081298, 2527243487, 3748687001, 4282500226, 2292234474, 3493081789, 4125183123, 838037657)
+RESPONSE = (b'{"status":"verified","output":0,"public_memory":[0,4294967295],"steps":512,'
+            b'"guest_image_id":' + IMAGE + b',"input_commitment":' + words(*[4] * 32)
+            + b',"program_sha256":' + words(*[1] * 32) + b',"specification_sha256":' + words(*[3] * 32)
+            + b',"receipt_sha256":' + words(*[2] * 32) + b'}\n')
+LARGE = b'a' * (2 << 20)
+
+
+def request_bytes(bundle):
+    return (b'{"app":"demo","public":"{}","bundle":"' + bundle + b'","expected_input_commitment":'
+            + words(*[4] * 32) + b'}')
+
+
+def child(body):
+    return f'#!{sys.executable}\nimport fcntl, hashlib, os, signal, sys\n{body}\n'.encode()
+
+
+def exact_request(bundle, then):
+    """Synthetic child: exit 1 unless stdin is exactly the framed request, then run `then`."""
+    return child(f'data = sys.stdin.buffer.read()\n'
+                 f'if hashlib.sha256(data).hexdigest() != {sha256(request_bytes(bundle)).hexdigest()!r}: sys.exit(1)\n'
+                 f'{then}')
+
+
+def respond(raw):
+    return f'sys.stdout.buffer.write({raw!r})'
+
+
+@unittest.skipUnless(sys.platform.startswith('linux'), 'sealed memfd execution is Linux-only')
+class NativeVerifierIoTest(unittest.TestCase):
+    def setUp(self):
+        self.fds = open_fds()
+        self.tmp = tempfile.TemporaryDirectory(dir=Path(__file__).parent)
+        self.path = Path(self.tmp.name) / 'verifier'
+        self.request = bound_request()
+        self.processes = []
+
+        def spawn(*args, **kwargs):
+            process = REAL_POPEN(*args, **kwargs)
+            self.processes.append(process)
+            return process
+
+        for patch in (mock.patch.object(verifier.subprocess, 'Popen', side_effect=spawn),
+                      mock.patch.object(verifier._process.os, 'killpg', wraps=os.killpg)):
+            patch.start()
+            self.addCleanup(patch.stop)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+        self.assertEqual(open_fds(), self.fds, 'owned descriptors leaked')
+
+    def native(self, content):
+        self.path.write_bytes(content)
+        self.path.chmod(0o755)
+        return NativeVerifier(self.path, sha256(content).digest())
+
+    def expected(self, output=0):
+        return Evidence('demo', self.request.invocation.digest(), b'\4' * 32, b'\1' * 32, b'\2' * 32, output)
+
+    def assert_cleaned(self, killed):
+        """killed: True (child still ran at rejection), False (exited 0 itself), 'either' (racy by nature)."""
+        (process,) = self.processes
+        allowed = {True: {-signal.SIGKILL}, False: {0}, 'either': {0, -signal.SIGKILL}}[killed]
+        self.assertIn(process.returncode, allowed)
+        self.assertTrue(process.stdin.closed and process.stdout.closed and process.stderr.closed)
+        with self.assertRaises(ChildProcessError):  # already reaped
+            os.waitpid(process.pid, os.WNOHANG)
+        os.killpg.assert_called_with(process.pid, signal.SIGKILL)
+
+    def assert_rejected(self, native, bundle, reason, killed=None):
+        with self.assertRaisesRegex(VerificationRejected, reason) as caught:
+            native.verify(self.request, bundle)
+        self.assertNotIn('SECRET', str(caught.exception))
+        self.assertIsNone(caught.exception.__cause__)
+        if killed is not None:
+            self.assert_cleaned(killed)
+        return caught.exception
+
+    def test_exact_request_and_complete_response_with_output_zero(self):
+        native = self.native(exact_request(b'bundle', 'assert os.getpgid(0) == os.getpid()\n' + respond(RESPONSE)))
+        self.assertEqual(native.verify(self.request, b'bundle'), self.expected(0))
+        self.assert_cleaned(killed=False)
+        self.assertEqual([field.name for field in dataclasses.fields(Evidence)],
+                         ['project', 'context', 'input_commitment', 'program', 'receipt', 'output'])
+        self.assertTrue(Evidence.__dataclass_params__.frozen)
+        self.assertEqual((verifier.CHILD_SECONDS, verifier.RESPONSE_LIMIT), (60, 65536))
+
+    def test_empty_transport_request_closes_stdin_and_reaps_child(self):
+        # NativeVerifier always frames a nonempty JSON request, but the narrow
+        # exchange helper must close stdin correctly at its zero-byte boundary.
+        self.path.write_bytes(child('if sys.stdin.buffer.read(): sys.exit(1)\n' + respond(RESPONSE)))
+        self.path.chmod(0o755)
+        result = verifier._process.exchange([str(self.path)], b'', pass_fds=(), seconds=60, limit=65536)
+        self.assertEqual(result, RESPONSE)
+        self.assert_cleaned(killed=False)
+
+    def test_large_request_is_drained_in_small_reads(self):
+        body = ('data = b""\nwhile chunk := os.read(0, 4096): data += chunk\n'
+                f'if hashlib.sha256(data).hexdigest() != {sha256(request_bytes(LARGE)).hexdigest()!r}: sys.exit(1)\n'
+                + respond(RESPONSE))
+        self.assertEqual(self.native(child(body)).verify(self.request, LARGE), self.expected(0))
+        self.assert_cleaned(killed=False)
+
+    def test_bidirectional_backpressure_at_the_response_limit_does_not_deadlock(self):
+        # stdout is shrunk to one page and filled before stdin is read. Exit 0 and the
+        # parse-stage reason prove full delivery and inclusive acceptance of 65536 bytes.
+        body = ('fcntl.fcntl(1, fcntl.F_SETPIPE_SZ, 4096)\nos.write(1, b"x" * 65536)\n'
+                f'if hashlib.sha256(sys.stdin.buffer.read()).hexdigest() != {sha256(request_bytes(LARGE)).hexdigest()!r}:'
+                ' sys.exit(1)')
+        self.assert_rejected(self.native(child(body)), LARGE, 'response is malformed', killed=False)
+
+    def test_finite_stdout_overflow_rejects(self):
+        native = self.native(exact_request(b'bundle', 'sys.stdout.buffer.write(b"SECRET" + b"x" * 65531)'))
+        self.assert_rejected(native, b'bundle', 'response exceeds its size limit', killed='either')
+
+    def test_endless_stdout_flood_rejects_and_kills(self):
+        native = self.native(child('while True: os.write(1, b"SECRET" * 4096)'))
+        self.assert_rejected(native, b'bundle', 'response exceeds its size limit', killed=True)
+
+    def test_any_stderr_rejects(self):
+        native = self.native(exact_request(b'bundle', respond(RESPONSE) + '\nsys.stderr.buffer.write(b"SECRET")'))
+        self.assert_rejected(native, b'bundle', 'verifier wrote diagnostics', killed='either')
+
+    def test_stderr_flood_before_reading_large_request_rejects_and_kills(self):
+        native = self.native(child('while True: os.write(2, b"SECRET" * 4096)'))
+        self.assert_rejected(native, LARGE, 'verifier wrote diagnostics', killed=True)
+
+    def test_child_exiting_before_reading_large_request_rejects(self):
+        native = self.native(child(respond(RESPONSE)))
+        self.assert_rejected(native, LARGE, 'exited before reading the request', killed=False)
+
+    def test_child_closing_stdin_then_hanging_rejects_and_kills(self):
+        native = self.native(child('os.close(0)\nsignal.pause()'))
+        self.assert_rejected(native, LARGE, 'exited before reading the request', killed=True)
+
+    def test_nonzero_exit_rejects_even_with_valid_response(self):
+        native = self.native(exact_request(b'bundle', respond(RESPONSE) + '\nsys.stdout.flush()\nos._exit(3)'))
+        self.assert_rejected(native, b'bundle', 'exited unsuccessfully')
+        self.assertEqual(self.processes[0].returncode, 3)
+        self.assertTrue(self.processes[0].stdout.closed)
+
+    def test_timeout_after_delivery_rejects_and_kills(self):
+        native = self.native(exact_request(b'bundle', 'signal.pause()'))
+
+        def clock():  # deterministic: time passes the 60 s lifetime once the request is delivered
+            return 61.0 if self.processes[0].stdin.closed else 0.0
+
+        with mock.patch.object(verifier._process, '_clock', side_effect=clock):
+            self.assert_rejected(native, b'bundle', 'exceeded its lifetime', killed=True)
+
+    def test_completion_observed_after_deadline_rejects(self):
+        native = self.native(exact_request(b'bundle', respond(RESPONSE)))
+        state = {'now': 0.0, 'pidfd': None}
+        real_poll = verifier._process.select.poll
+        real_pidfd_open = os.pidfd_open
+
+        def open_pidfd(pid):
+            state['pidfd'] = real_pidfd_open(pid)
+            return state['pidfd']
+
+        class LateCompletion:
+            def __init__(self):
+                self.poller = real_poll()
+
+            def __getattr__(self, name):
+                return getattr(self.poller, name)
+
+            def poll(self, milliseconds):
+                events = self.poller.poll(milliseconds)
+                if any(fd == state['pidfd'] for fd, _ in events):
+                    state['now'] = 61.0
+                return events
+
+        with mock.patch.object(verifier._process, '_clock', side_effect=lambda: state['now']), \
+                mock.patch.object(verifier._process.os, 'pidfd_open', side_effect=open_pidfd), \
+                mock.patch.object(verifier._process.select, 'poll', LateCompletion):
+            self.assert_rejected(native, b'bundle', 'exceeded its lifetime', killed=False)
+
+    def test_unsupported_platform_rejects_without_execution(self):
+        native = self.native(child(respond(RESPONSE)))
+        with mock.patch.object(verifier._process, '_supported', return_value=False):
+            self.assert_rejected(native, b'bundle', 'unsupported on this platform')
+        verifier.subprocess.Popen.assert_not_called()
+
+    def test_invalid_calls_and_missing_executable_reject_without_execution(self):
+        native = self.native(child(respond(RESPONSE)))
+        for request, bundle in ((object(), b'bundle'), (self.request, 'bundle'), (self.request, bytearray(b'b')),
+                                (self.request, b'a' * ((2 << 20) + 1))):
+            with self.assertRaises(VerificationRejected):
+                native.verify(request, bundle)
+        with self.assertRaisesRegex(VerificationRejected, 'could not be acquired'):
+            NativeVerifier(self.path.with_name('missing'), sha256(b'').digest())
+        loop = self.path.with_name('loop')
+        loop.symlink_to('loop')
+        with self.assertRaisesRegex(VerificationRejected, 'could not be acquired'):
+            NativeVerifier(loop, sha256(b'').digest())
+        verifier.subprocess.Popen.assert_not_called()
+
+    def test_malformed_response_through_child_hides_output(self):
+        native = self.native(exact_request(b'bundle', respond(b'{"SECRET":\xff}\n')))
+        self.assert_rejected(native, b'bundle', 'response is malformed', killed=False)
+
+    def test_replacement_attack_payload_is_schema_valid(self):
+        # The forger used by the snapshot attacks would be admitted if it were what ran,
+        # so its rejection there is due to the sealed snapshot, not to response parsing.
+        self.assertEqual(self.native(FORGER).verify(self.request, b'bundle'), self.expected(7))
+
+
+class ResponseSchemaTest(unittest.TestCase):
+    commitment = b'\4' * 32
+
+    def parse(self, raw):
+        return verifier._response(raw, self.commitment)
+
+    def test_complete_response_boundaries(self):
+        self.assertEqual(self.parse(RESPONSE), (0, b'\1' * 32, b'\2' * 32))
+        edges = {b'"output":0': b'"output":4294967295', b'"steps":512': b'"steps":1',
+                 b'"public_memory":[0,4294967295]': b'"public_memory":' + words(*[7] * 16)}
+        for old, new in edges.items():
+            with self.subTest(new=new):
+                self.assertEqual(RESPONSE.count(old), 1)
+                self.assertEqual(len(self.parse(RESPONSE.replace(old, new))), 3)
+        self.assertEqual(self.parse(RESPONSE.replace(b'"public_memory":[0,4294967295]', b'"public_memory":[]'))[0], 0)
+
+    def test_invalid_responses_reject_precisely(self):
+        output, memory, steps = b'"output":0', b'"public_memory":[0,4294967295]', b'"steps":512'
+        image, program = b'"guest_image_id":' + IMAGE, b'"program_sha256":' + words(*[1] * 32)
+        cases = [
+            # framing, encoding and JSON syntax
+            (b'"verified"', b'"verified\xff"', 'malformed'),
+            (b'}\n', b'}', 'malformed'),
+            (b'}\n', b'}\n\n', 'malformed'),
+            (b'}\n', b'} \n', 'malformed'),
+            (b'{"status"', b' {"status"', 'malformed'),
+            (b'}\n', b'}}\n', 'malformed'),
+            (b'}\n', b',\n', 'malformed'),
+            (output, b'"output":1' + b'0' * 5000, 'malformed'),
+            (memory, b'"public_memory":' + b'[' * 30000 + b']' * 30000, 'malformed'),
+            # object shape
+            (output, output + b',"output":0', 'duplicate fields'),
+            (output, output + b',"extra":0', 'differ from the schema'),
+            (steps + b',', b'', 'differ from the schema'),
+            (b'"status":"verified",', b'', 'differ from the schema'),
+            (b'"verified"', b'"rejected"', 'not verified'),
+            (b'"verified"', b'true', 'not verified'),
+            # numbers and aliases
+            (output, b'"output":false', 'invalid verifier output'),
+            (output, b'"output":true', 'invalid verifier output'),
+            (output, b'"output":"0"', 'invalid verifier output'),
+            (output, b'"output":null', 'invalid verifier output'),
+            (output, b'"output":-1', 'invalid verifier output'),
+            (output, b'"output":4294967296', 'invalid verifier output'),
+            (output, b'"output":0.0', 'non-integer numbers'),
+            (output, b'"output":0e0', 'non-integer numbers'),
+            (output, b'"output":NaN', 'non-integer numbers'),
+            (output, b'"output":-Infinity', 'non-integer numbers'),
+            (memory, b'"public_memory":' + words(*[0] * 17), 'invalid verifier public memory'),
+            (memory, b'"public_memory":[4294967296]', 'invalid verifier public memory'),
+            (memory, b'"public_memory":[true]', 'invalid verifier public memory'),
+            (memory, b'"public_memory":{}', 'invalid verifier public memory'),
+            (memory, b'"public_memory":0', 'invalid verifier public memory'),
+            (steps, b'"steps":0', 'invalid verifier steps'),
+            (steps, b'"steps":513', 'invalid verifier steps'),
+            (steps, b'"steps":true', 'invalid verifier steps'),
+            (image, b'"guest_image_id":' + words(*[0] * 7), 'invalid verifier image'),
+            (image, b'"guest_image_id":' + words(*[0] * 9), 'invalid verifier image'),
+            (image, b'"guest_image_id":' + words(*[0] * 7, -1), 'invalid verifier image'),
+            (program, b'"program_sha256":' + words(*[1] * 31), 'invalid verifier program_sha256'),
+            (program, b'"program_sha256":' + words(*[1] * 33), 'invalid verifier program_sha256'),
+            (program, b'"program_sha256":' + words(*[1] * 31, 256), 'invalid verifier program_sha256'),
+            (program, b'"program_sha256":[true' + b',1' * 31 + b']', 'invalid verifier program_sha256'),
+            (program, b'"program_sha256":"' + b'01' * 32 + b'"', 'invalid verifier program_sha256'),
+            (b'"specification_sha256":[3,', b'"specification_sha256":[', 'invalid verifier specification_sha256'),
+            (b'"receipt_sha256":[2,', b'"receipt_sha256":[-2,', 'invalid verifier receipt_sha256'),
+            (b'"input_commitment":[4,', b'"input_commitment":[', 'invalid verifier input_commitment'),
+            (b'"input_commitment":[4,', b'"input_commitment":[5,', 'differs from the expected commitment'),
+        ]
+        for old, new, reason in cases:
+            with self.subTest(new=new[:60], reason=reason):
+                self.assertIn(old, RESPONSE)
+                with self.assertRaisesRegex(VerificationRejected, reason):
+                    self.parse(RESPONSE.replace(old, new, 1))
+        for raw in (b'', b'\n', b'[]\n', b'"verified"\n', b'null\n', b'{}\n'):
+            with self.subTest(raw=raw), self.assertRaises(VerificationRejected):
+                self.parse(raw)
+
+
+if __name__ == '__main__':
+    unittest.main()
