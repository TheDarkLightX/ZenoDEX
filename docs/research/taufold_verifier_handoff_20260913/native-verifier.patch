+            return REAL_POPEN(args, **kwargs)
+
+        with mock.patch.object(verifier._process, 'exchange', side_effect=exchange), \
+                mock.patch.object(verifier.subprocess, 'Popen', side_effect=popen):
+            evidence = native.verify(self.request, b'bundle')
+        self.assertEqual(evidence, Evidence('demo', self.request.invocation.digest(), b'\4' * 32, b'\1' * 32, b'\2' * 32, 0))
+        self.assertEqual(len(seen), 1)
+
+    def test_snapshot_has_required_seals(self):
+        descriptor = verifier._sealed_snapshot(self.install(HONEST), sha256(HONEST).digest())
+        try:
+            required = (verifier.fcntl.F_SEAL_SEAL | verifier.fcntl.F_SEAL_SHRINK
+                        | verifier.fcntl.F_SEAL_GROW | verifier.fcntl.F_SEAL_WRITE)
+            self.assertEqual(verifier.fcntl.fcntl(descriptor, verifier.fcntl.F_GET_SEALS) & required, required)
+            self.assertEqual(os.pread(descriptor, len(HONEST) + 1, 0), HONEST)
+            for change in (lambda: os.pwrite(descriptor, b'x', 0), lambda: os.ftruncate(descriptor, 1),
+                           lambda: os.ftruncate(descriptor, len(HONEST) + 1),
+                           lambda: verifier.fcntl.fcntl(descriptor, verifier.fcntl.F_ADD_SEALS, 0)):
+                with self.assertRaises(PermissionError):
+                    change()
+            self.install(FORGER)
+            self.assertEqual(os.pread(descriptor, len(HONEST) + 1, 0), HONEST)
+        finally:
+            os.close(descriptor)
+
+    def test_pin_mismatch_rejects_without_execution(self):
+        with self.assertRaises(VerificationRejected):
+            NativeVerifier(self.install(FORGER), sha256(HONEST).digest())
+        native = NativeVerifier(self.install(HONEST), sha256(HONEST).digest())
+        self.install(FORGER)
+        with mock.patch.object(verifier.subprocess, 'Popen') as run, self.assertRaises(VerificationRejected):
+            native.verify(self.request, b'bundle')
+        run.assert_not_called()
+
+    def test_resource_bound_and_nonregular_inputs_reject_without_execution(self):
+        native = NativeVerifier(self.install(HONEST), sha256(HONEST).digest())
+        self.assertEqual(verifier.VERIFIER_LIMIT, 128 << 20)
+
+        def fifo():
+            self.path.unlink(missing_ok=True); os.mkfifo(self.path)
+
+        def directory():
+            self.path.unlink(missing_ok=True); self.path.mkdir()
+
+        def symlink():
+            self.install(HONEST, self.path.with_name('target')); self.path.unlink(missing_ok=True); self.path.symlink_to('target')
+
+        def empty():
+            self.path.unlink(missing_ok=True); self.install(b'')
