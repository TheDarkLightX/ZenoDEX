+        with mock.patch.object(verifier.subprocess, 'Popen') as run:
+            with mock.patch.object(verifier, 'VERIFIER_LIMIT', len(HONEST) - 1), self.assertRaises(VerificationRejected):
+                native.verify(self.request, b'bundle')
