+#!/usr/bin/env python3
+"""Measure the owned-snapshot zUSD bulk fee-claim guard.
+
+The baseline caller and helper are frozen copies of the pre-change map-copying
+path. The candidate is the current private integration guard. This tool times
+only the guard on a synthetic fee-state fixture and emits advisory JSON; it
+does not represent a full monetary transaction, production workload, or
+release evidence.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import inspect
+import json
+import subprocess
+import sys
+import time
+from collections.abc import Callable
+from pathlib import Path
+from statistics import median
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+import src.integration.zusd_monetary_bridge as bridge  # noqa: E402
+
+_E8 = bridge.E8
+_FEE_SCALE = bridge._FEE_ACC_SCALE
+_MAX_STAKEHOLDERS = 4_096
+_BASELINE_HELPER = "baseline_fee_stake_claimable_e8"
+_CANDIDATE_HELPER = "candidate_fee_stake_claimable_e8"
+_Guard = Callable[..., None]
+
+
+def _legacy_fee_stake_claimable_e8(
+    fee_fields: dict[str, Any],
+    account: str,
+) -> int:
+    """Frozen pre-change helper retained as the benchmark oracle."""
+
+    active = dict(fee_fields["active_fee_stakes"])
+    reward_debt = dict(fee_fields["fee_stake_reward_debt_e8"])
+    shares = int(active.get(account, 0))
+    if shares <= 0:
+        return 0
+    accrued = (int(shares) * int(fee_fields["staking_zusd_fee_acc_per_share_e8"])) // _FEE_SCALE
+    return max(0, accrued - int(reward_debt.get(account, 0)))
+
+
+def _legacy_require_fee_routes_transport_exact(
+    *,
+    authority_binding: bridge.ZUSDAuthorityBinding,
+    fee_fields: dict[str, Any],
+    fee_effects: dict[str, int],
+) -> None:
+    """Frozen pre-change bulk caller with one full copy per claimant."""
+
+    routed: dict[str, int] = {}
+    for field_name in (
+        "mint_fee_host_e8",
+        "mint_fee_staking_e8",
+        "mint_fee_protocol_e8",
+    ):
+        amount_e8 = bridge._require_nonnegative_int(
+            fee_effects.get(field_name),
+            name=field_name,
+        )
+        if amount_e8 % _E8 != 0:
+            raise ValueError("mint fee routes must be whole zUSD at v0.1 transport")
+        routed[field_name] = amount_e8
+
+    if routed["mint_fee_protocol_e8"] > 0:
+        bridge._require_protocol_fee_recipient(authority_binding)
+
+    host_fees = dict(fee_fields["host_zusd_fees_e8"])
+    if any(int(amount_e8) % _E8 != 0 for amount_e8 in host_fees.values()):
+        raise ValueError("host fee claims must be whole zUSD at v0.1 transport")
+
+    active_stakes = dict(fee_fields["active_fee_stakes"])
+    claimables = tuple(
+        _legacy_fee_stake_claimable_e8(fee_fields, pubkey)
+        for pubkey in sorted(active_stakes)
+    )
+    if any(claimable_e8 % _E8 != 0 for claimable_e8 in claimables):
+        raise ValueError("staking fee claims must be whole zUSD at v0.1 transport")
+    if sum(claimables) != int(fee_fields["staking_zusd_fee_pool_e8"]):
+        raise ValueError(
+            "staking fee pool must equal exactly claimable fees at v0.1 transport"
+        )
+
+
+def _fixture(stakeholders: int) -> dict[str, Any]:
+    active = {
+        f"0x{index + 1:096x}": 1
+        for index in range(stakeholders)
+    }
+    # Positive debt keeps both legacy map copies populated while the exact
+    # formula remains one whole zUSD per account.
+    reward_debt = {account: _E8 for account in active}
+    return {
+        "host_zusd_fees_e8": {},
+        "active_fee_stakes": active,
+        "fee_stake_reward_debt_e8": reward_debt,
+        "staking_zusd_fee_acc_per_share_e8": 2 * _E8 * _FEE_SCALE,
+        "staking_zusd_fee_pool_e8": stakeholders * _E8,
+    }
+
+
+def _fee_effects() -> dict[str, int]:
+    return {
+        "mint_fee_host_e8": 0,
+        "mint_fee_staking_e8": 0,
+        "mint_fee_protocol_e8": 0,
+    }
+
+
+def _outcome(
+    guard: _Guard,
+    *,
+    fee_fields: dict[str, Any],
+    fee_effects: dict[str, int],
+) -> dict[str, object]:
+    try:
+        guard(
+            authority_binding=bridge.ZUSDAuthorityBinding(),
+            fee_fields=fee_fields,
+            fee_effects=fee_effects,
+        )
+    except Exception as exc:
+        return {
+            "ok": False,
+            "exception_type": type(exc).__name__,
+            "error": str(exc),
+        }
+    return {"ok": True, "exception_type": None, "error": None}
+
+
+def _timed(
+    guard: _Guard,
+    *,
+    fee_fields: dict[str, Any],
+    fee_effects: dict[str, int],
+) -> tuple[float, dict[str, object]]:
+    began_ns = time.perf_counter_ns()
+    outcome = _outcome(
+        guard,
+        fee_fields=fee_fields,
+        fee_effects=fee_effects,
+    )
+    elapsed_ms = (time.perf_counter_ns() - began_ns) / 1_000_000
+    return elapsed_ms, outcome
+
+
+def _measure_case(stakeholders: int, *, repeats: int) -> dict[str, object]:
+    fee_fields = _fixture(stakeholders)
+    fee_effects = _fee_effects()
+    baseline_guard = _legacy_require_fee_routes_transport_exact
+    candidate_guard = bridge._require_fee_routes_transport_exact
+    baseline_warm = _outcome(
+        baseline_guard,
+        fee_fields=fee_fields,
+        fee_effects=fee_effects,
+    )
+    candidate_warm = _outcome(
+        candidate_guard,
+        fee_fields=fee_fields,
+        fee_effects=fee_effects,
+    )
+    if baseline_warm != candidate_warm:
+        raise RuntimeError(
+            f"baseline/candidate outcomes disagreed before timing at stakeholders={stakeholders}"
+        )
+
+    samples: dict[str, list[float]] = {"baseline": [], "candidate": []}
+    outcomes: dict[str, dict[str, object]] = {}
+    for repeat in range(repeats):
+        order: tuple[tuple[str, _Guard], tuple[str, _Guard]]
+        if repeat % 2 == 0:
+            order = (("baseline", baseline_guard), ("candidate", candidate_guard))
+        else:
+            order = (("candidate", candidate_guard), ("baseline", baseline_guard))
+        for run in order:
+            name: str = run[0]
+            guard: _Guard = run[1]
+            elapsed_ms, outcome = _timed(
+                guard,
+                fee_fields=fee_fields,
+                fee_effects=fee_effects,
+            )
+            samples[name].append(elapsed_ms)
+            if outcome != baseline_warm:
+                raise RuntimeError(
+                    f"guard outcome changed during timing at stakeholders={stakeholders}"
+                )
+            outcomes[name] = outcome
+
+    baseline_median = float(median(samples["baseline"]))
+    candidate_median = float(median(samples["candidate"]))
+    speedup = baseline_median / candidate_median if candidate_median > 0 else float("inf")
+    expected_claimable_e8 = stakeholders * _E8
+    return {
+        "fixture": {
+            "stakeholders": stakeholders,
+            "shares_per_stakeholder": 1,
+            "accumulator_e8": 2 * _E8 * _FEE_SCALE,
+            "reward_debt_e8_per_stakeholder": _E8,
+            "staking_pool_e8": stakeholders * _E8,
+            "claimable_formula": "max(0, (shares * accumulator_e8) // fee_acc_scale - debt_e8)",
+            "expected_claimable_sum_e8": expected_claimable_e8,
+            "expected_legacy_copied_entries": stakeholders
+            + 2 * stakeholders * stakeholders,
+            "expected_candidate_copied_entries_upper_bound": 2 * stakeholders,
+        },
+        "outcomes": {
+            "baseline": outcomes["baseline"],
+            "candidate": outcomes["candidate"],
+            "equal": outcomes["baseline"] == outcomes["candidate"],
+        },
+        "baseline": {
+            "samples_ms": samples["baseline"],
+            "median_ms": baseline_median,
+        },
+        "candidate": {
+            "samples_ms": samples["candidate"],
+            "median_ms": candidate_median,
+        },
+        "median_speedup": speedup,
+        "candidate_at_least_4x": (
+            speedup >= 4.0 if stakeholders == _MAX_STAKEHOLDERS else None
+        ),
+        "candidate_at_least_4x_applicable": stakeholders == _MAX_STAKEHOLDERS,
+        "candidate_at_least_4x_condition": (
+            f"stakeholders == {_MAX_STAKEHOLDERS}"
+        ),
+        "independent_formula_matches_pool": expected_claimable_e8
+        == int(fee_fields["staking_zusd_fee_pool_e8"]),
+    }
+
+
+def _source_hashes() -> dict[str, str]:
+    source_path = ROOT / "src/integration/zusd_monetary_bridge.py"
+    tool_path = Path(__file__).resolve()
+
+    def _function_hash(function: Callable[..., object]) -> str:
+        return hashlib.sha256(inspect.getsource(function).encode("utf-8")).hexdigest()
+
+    return {
+        "zusd_monetary_bridge_py_sha256": hashlib.sha256(source_path.read_bytes()).hexdigest(),
+        "benchmark_py_sha256": hashlib.sha256(tool_path.read_bytes()).hexdigest(),
+        f"{_BASELINE_HELPER}_sha256": _function_hash(_legacy_fee_stake_claimable_e8),
+        "baseline_bulk_caller_sha256": _function_hash(_legacy_require_fee_routes_transport_exact),
+        f"{_CANDIDATE_HELPER}_sha256": _function_hash(bridge._fee_stake_claimable_e8),
+        "candidate_bulk_snapshot_helper_sha256": _function_hash(
+            bridge._bulk_fee_stake_claimables_e8
+        ),
+        "candidate_bulk_caller_sha256": _function_hash(bridge._require_fee_routes_transport_exact),
+        "candidate_state_invariant_caller_sha256": _function_hash(bridge._state_invariant_error),
+    }
+
+
+def _git_head() -> str:
+    completed = subprocess.run(
+        ["git", "rev-parse", "HEAD"],
+        cwd=ROOT,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return completed.stdout.strip()
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--repeats",
+        type=int,
+        default=5,
+        help="measured samples per path and case (minimum 3; default: 5)",
+    )
+    parser.add_argument(
+        "--counts",
+        type=int,
+        nargs="+",
+        default=(0, 1, 256),
+        help="stakeholder counts; pass 4096 explicitly for the large bound",
+    )
+    args = parser.parse_args()
+    if args.repeats < 3:
+        parser.error("--repeats must be at least 3")
+    if any(count < 0 or count > _MAX_STAKEHOLDERS for count in args.counts):
+        parser.error("--counts must be between 0 and 4096")
+    return args
+
+
+def main() -> int:
+    args = _parse_args()
+    cases = [_measure_case(count, repeats=args.repeats) for count in args.counts]
+    report = {
+        "tool": "benchmark_zusd_bulk_fee_claims_v1",
+        "subject_head": _git_head(),
+        "repeats": args.repeats,
+        "cases": cases,
+        "source_hashes": _source_hashes(),
+        "claim_scope": {
+            "measured": [
+                "Python zUSD whole-transport fee guard",
+                "Exact baseline/candidate guard outcomes and error tuples",
+                "Synthetic stakeholder counts selected by this tool",
+            ],
+            "nonclaims": [
+                "No full monetary-path or transaction throughput claim",
+                "No native, Rust, guest, proof, verifier, release, or production claim",
+                "No economic parameter or product stakeholder-limit selection",
+                "Synthetic timings do not represent arbitrary workload distributions",
+            ],
+        },
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
