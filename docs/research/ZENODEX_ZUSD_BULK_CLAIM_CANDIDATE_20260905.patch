+def _is_exact_fee_stake_map(value: object) -> bool:
+    if type(value) is not dict:
+        return False
+    return all(
+        type(account) is str and type(amount) is int
+        for account, amount in value.items()
+    )
+
+
+def _has_exact_string_keys(value: object) -> bool:
+    return type(value) is dict and all(type(key) is str for key in value)
+
+
+_MISSING_FEE_STAKE_ACCUMULATOR = object()
