+def _bulk_fee_stake_claimables_e8(
+    fee_fields: Mapping[str, Any],
+) -> tuple[int, ...]:
+    """Calculate all transport claimant balances with an exact-map fast path.
+
+    The fast path owns both copied maps and only accepts exact primitive maps
+    and an exact ``int`` accumulator. Every other input uses the legacy
+    singleton helper, preserving its map-snapshot and scalar-conversion order.
+    """
+
+    exact_outer_fields = (
+        type(fee_fields) is dict
+        and _has_exact_string_keys(fee_fields)
+    )
+    active_source = fee_fields["active_fee_stakes"]
+    active_stakes = dict(active_source)
+    claimant_pubkeys = tuple(sorted(active_stakes))
+    if not claimant_pubkeys:
+        return ()
+
+    if (
+        exact_outer_fields
+        and type(active_source) is dict
+        and _is_exact_fee_stake_map(active_stakes)
+    ):
+        reward_source = fee_fields["fee_stake_reward_debt_e8"]
+        if _is_exact_fee_stake_map(reward_source):
+            accumulator_e8 = fee_fields.get(
+                "staking_zusd_fee_acc_per_share_e8",
+                _MISSING_FEE_STAKE_ACCUMULATOR,
+            )
+            if type(accumulator_e8) is int:
+                owned_active = cast(dict[str, int], active_stakes)
+                owned_reward_debt = cast(dict[str, int], dict(reward_source))
+                return tuple(
+                    (
+                        0
+                        if owned_active[pubkey] <= 0
+                        else max(
+                            0,
+                            _fee_stake_debt_for(
+                                owned_active[pubkey],
+                                accumulator_e8,
+                            )
+                            - owned_reward_debt.get(pubkey, 0),
+                        )
+                    )
+                    for pubkey in claimant_pubkeys
+                )
+
+    return tuple(
+        _fee_stake_claimable_e8(fee_fields, pubkey)
+        for pubkey in claimant_pubkeys
+    )
+
