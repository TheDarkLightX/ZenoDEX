+"""Differential and stateful evidence for the zUSD bulk fee-claim guard."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator, Mapping
+from dataclasses import replace
+from typing import Any, cast
+
+import pytest
+
+import src.integration.zusd_monetary_bridge as bridge
+from src.core.consensus_time import (
+    clock_policy_schedule_hash_v1,
+    default_height_only_clock_schedule_v1,
+    verify_execution_clock_v1,
+)
+from src.core.dex import DexState
+from src.core.zusd import E8, init_state
+from src.state import BalanceTable, LPTable
+
+_FEE_SCALE = bridge._FEE_ACC_SCALE
+_ACCOUNT = "0x" + "01" * 48
+_SECOND_ACCOUNT = "0x" + "02" * 48
+_FEE_STAKE_ASSET = "0x" + "ab" * 32
+
+
+def _legacy_fee_stake_claimable_e8(
+    fee_fields: Mapping[str, Any],
+    account: str,
+) -> int:
+    """Frozen pre-change helper used as an independent behavior oracle."""
+
+    active = dict(fee_fields["active_fee_stakes"])
+    reward_debt = dict(fee_fields["fee_stake_reward_debt_e8"])
+    shares = int(active.get(account, 0))
+    if shares <= 0:
+        return 0
+    accrued = (int(shares) * int(fee_fields["staking_zusd_fee_acc_per_share_e8"])) // _FEE_SCALE
+    return max(0, accrued - int(reward_debt.get(account, 0)))
+
+
+def _claim_formula(*, shares: int, accumulator_e8: int, debt_e8: int) -> int:
+    if shares <= 0:
+        return 0
+    return max(0, (shares * accumulator_e8) // _FEE_SCALE - debt_e8)
+
+
+def _fee_fields(
+    *,
+    active: Mapping[str, Any],
+    reward_debt: Mapping[str, Any],
+    accumulator_e8: Any,
+    staking_pool_e8: int,
+    host_fees: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    return {
+        "host_zusd_fees_e8": {} if host_fees is None else host_fees,
+        "active_fee_stakes": active,
+        "fee_stake_reward_debt_e8": reward_debt,
+        "staking_zusd_fee_acc_per_share_e8": accumulator_e8,
+        "staking_zusd_fee_pool_e8": staking_pool_e8,
+    }
+
+
+def _fee_effects(
+    *,
+    host_e8: int = 0,
+    staking_e8: int = 0,
+    protocol_e8: int = 0,
+) -> dict[str, int]:
+    return {
+        "mint_fee_host_e8": host_e8,
+        "mint_fee_staking_e8": staking_e8,
+        "mint_fee_protocol_e8": protocol_e8,
+    }
+
+
+def _legacy_transport_outcome(
+    *,
+    fee_fields: Mapping[str, Any],
+    fee_effects: Mapping[str, Any],
+) -> tuple[str, str | None]:
+    """Frozen caller loop retaining the old per-claimant map copies."""
+
+    try:
+        routed: dict[str, int] = {}
+        for field_name in (
+            "mint_fee_host_e8",
+            "mint_fee_staking_e8",
+            "mint_fee_protocol_e8",
+        ):
+            amount_e8 = bridge._require_nonnegative_int(
+                fee_effects.get(field_name),
+                name=field_name,
+            )
+            if amount_e8 % E8 != 0:
+                raise ValueError("mint fee routes must be whole zUSD at v0.1 transport")
+            routed[field_name] = amount_e8
+
+        if routed["mint_fee_protocol_e8"] > 0:
+            bridge._require_protocol_fee_recipient(bridge.ZUSDAuthorityBinding())
+
+        host_fees = dict(fee_fields["host_zusd_fees_e8"])
+        if any(int(amount_e8) % E8 != 0 for amount_e8 in host_fees.values()):
+            raise ValueError("host fee claims must be whole zUSD at v0.1 transport")
+
+        active_stakes = dict(fee_fields["active_fee_stakes"])
+        claimables = tuple(
+            _legacy_fee_stake_claimable_e8(fee_fields, pubkey)
+            for pubkey in sorted(active_stakes)
+        )
+        if any(claimable_e8 % E8 != 0 for claimable_e8 in claimables):
+            raise ValueError("staking fee claims must be whole zUSD at v0.1 transport")
+        if sum(claimables) != int(fee_fields["staking_zusd_fee_pool_e8"]):
+            raise ValueError(
+                "staking fee pool must equal exactly claimable fees at v0.1 transport"
+            )
+    except Exception as exc:
+        return type(exc).__name__, str(exc)
+    return "ok", None
+
+
+def _candidate_transport_outcome(
+    *,
+    fee_fields: Mapping[str, Any],
+    fee_effects: Mapping[str, Any],
+) -> tuple[str, str | None]:
+    try:
+        bridge._require_fee_routes_transport_exact(
+            authority_binding=bridge.ZUSDAuthorityBinding(),
+            fee_fields=fee_fields,
+            fee_effects=fee_effects,
+        )
+    except Exception as exc:
+        return type(exc).__name__, str(exc)
+    return "ok", None
+
+
+def _bulk_fixture(count: int) -> dict[str, Any]:
+    active = {
+        f"0x{index + 1:096x}": 1
+        for index in range(count)
+    }
+    return _fee_fields(
+        active=active,
+        reward_debt={account: E8 for account in active},
+        accumulator_e8=2 * E8 * _FEE_SCALE,
+        staking_pool_e8=count * E8,
+    )
+
+
+class _ProbeInt(int):
+    calls = 0
+
+    def __new__(cls, value: int) -> _ProbeInt:
+        return int.__new__(cls, value)
+
+    def __int__(self) -> int:
+        type(self).calls += 1
+        return int.__int__(self)
+
+
+class _DebtMutatingAccumulator(int):
+    """Changes the later claimant debt on its first legacy conversion."""
+
+    _reward_debt: dict[str, int]
+    _later_account: str
+    _converted: bool
+
+    def __new__(
+        cls,
+        value: int,
+        *,
+        reward_debt: dict[str, int],
+        later_account: str,
+    ) -> _DebtMutatingAccumulator:
+        instance = int.__new__(cls, value)
+        instance._reward_debt = reward_debt
+        instance._later_account = later_account
+        instance._converted = False
+        return instance
+
+    def __int__(self) -> int:
+        if not self._converted:
+            self._converted = True
+            self._reward_debt[self._later_account] = E8
+        return int.__int__(self)
+
+
+class _ExplodingMapping(Mapping[str, int]):
+    touched = False
+
+    def __getitem__(self, key: str) -> int:
+        type(self).touched = True
+        raise AssertionError(f"unexpected lazy mapping access: {key}")
+
+    def __iter__(self) -> Iterator[str]:
+        type(self).touched = True
+        raise AssertionError("unexpected lazy mapping iteration")
+
+    def __len__(self) -> int:
+        type(self).touched = True
+        raise AssertionError("unexpected lazy mapping length")
+
+
+class _ChangingMapping(Mapping[str, int]):
+    """Stateful Mapping whose second snapshot makes fallback behavior visible."""
+
+    def __init__(self) -> None:
+        self.reads = 0
+
+    def __getitem__(self, key: str) -> int:
+        self.reads += 1
+        if key != _ACCOUNT:
+            raise KeyError(key)
+        return 1 if self.reads == 1 else 0
+
+    def __iter__(self) -> Iterator[str]:
+        return iter((_ACCOUNT,))
+
+    def __len__(self) -> int:
+        return 1
+
+
+class _SecondSnapshotRaisesMapping(Mapping[str, int]):
+    """Makes the legacy helper's second active-map snapshot observable."""
+
+    def __init__(self) -> None:
+        self.snapshots = 0
+
+    def __getitem__(self, key: str) -> int:
+        if key != _ACCOUNT:
+            raise KeyError(key)
+        return 1
+
+    def __iter__(self) -> Iterator[str]:
+        self.snapshots += 1
+        if self.snapshots == 2:
+            raise RuntimeError("active second snapshot")
+        return iter((_ACCOUNT,))
+
+    def __len__(self) -> int:
+        return 1
+
+
+class _RewardDebtLookupKey:
+    """A non-string outer key that changes debt on each matching lookup."""
+
+    def __init__(self, reward_debt: dict[str, int]) -> None:
+        self._reward_debt = reward_debt
+        self.lookups = 0
+
+    def __hash__(self) -> int:
+        return hash("fee_stake_reward_debt_e8")
+
+    def __eq__(self, other: object) -> bool:
+        if other != "fee_stake_reward_debt_e8":
+            return False
+        self.lookups += 1
+        self._reward_debt[_SECOND_ACCOUNT] = E8 if self.lookups == 1 else 0
+        return True
+
+
+def _state_with_claims(
+    *,
+    config: bridge.ZUSDMonetaryConfig | None = None,
+    claimable_e8: int = 100 * E8,
+) -> bridge.ZUSDMonetaryState:
+    if config is None:
+        core = replace(
+            init_state(),
+            collateral_e8=2 * claimable_e8,
+            debt_e8=claimable_e8,
+            free_debt_e8=claimable_e8,
+        )
+        return bridge.ZUSDMonetaryState(
+            core=core,
+            vault_owner_pubkey=_ACCOUNT,
+            active_fee_stakes={_ACCOUNT: 1},
+            fee_stake_reward_debt_e8={},
+            staking_zusd_fee_pool_e8=claimable_e8,
+            staking_zusd_fee_acc_per_share_e8=claimable_e8 * _FEE_SCALE,
+        )
+
+    base = bridge.init_monetary_state(config)
+    core = replace(
+        base.core,
+        collateral_e8=2 * claimable_e8,
+        debt_e8=claimable_e8,
+        free_debt_e8=claimable_e8,
+    )
+    return replace(
+        base,
+        core=core,
+        vault_owner_pubkey=_ACCOUNT,
+        active_fee_stakes={_ACCOUNT: 1},
+        fee_stake_reward_debt_e8={},
+        staking_zusd_fee_pool_e8=claimable_e8,
+        staking_zusd_fee_acc_per_share_e8=claimable_e8 * _FEE_SCALE,
+    )
+
+
+def _clock(chain_id: str, height: int):
+    schedule = default_height_only_clock_schedule_v1(chain_id=chain_id)
+    return verify_execution_clock_v1(
+        chain_id=chain_id,
+        height=height,
+        schedule=schedule,
+        expected_schedule_hash=clock_policy_schedule_hash_v1(schedule),
+    )
+
+
+@pytest.mark.parametrize(
+    ("shares", "accumulator_e8", "debt_e8"),
+    (
+        (0, E8 * _FEE_SCALE, 0),
+        (-3, E8 * _FEE_SCALE, 0),
+        (1, E8 * _FEE_SCALE, 0),
+        (3, 2 * E8 * _FEE_SCALE + 7, E8),
+        (1, E8 * _FEE_SCALE, 2 * E8),
+    ),
+)
+def test_claim_formula_matches_frozen_helper_and_candidate(
+    shares: int,
+    accumulator_e8: int,
+    debt_e8: int,
+) -> None:
+    fields = _fee_fields(
+        active={_ACCOUNT: shares},
+        reward_debt={_ACCOUNT: debt_e8},
+        accumulator_e8=accumulator_e8,
+        staking_pool_e8=0,
+    )
+
+    expected = _claim_formula(
+        shares=shares,
+        accumulator_e8=accumulator_e8,
+        debt_e8=debt_e8,
+    )
+    assert _legacy_fee_stake_claimable_e8(fields, _ACCOUNT) == expected
+    assert bridge._fee_stake_claimable_e8(fields, _ACCOUNT) == expected
+
