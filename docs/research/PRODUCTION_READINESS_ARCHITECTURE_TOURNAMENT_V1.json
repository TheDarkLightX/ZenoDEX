  "problem_state": {
    "representation": "A versioned architecture candidate is a component DAG, complete state-domain ownership map, four typed port roles, one composition contract, evidence rows, scenario rows, and counterexamples.",
    "abstraction": "Hard structural gates are derived by the checker; advisory integer metrics rank only designs with no structural violation or open blocker.",
    "constraints": [
      "ZenoLedger is the sole durable economic writer",
      "Tau and native policy verifiers return opaque admissions and carry no settlement authority",
      "direct execution and ZRPF use one deterministic Rust transition core",
      "cross-module value is reconciled and published by one expected-head compare-and-swap",
      "rejected commands preserve state, effects, history, nullifiers, and outbox",
      "old objects remain pinned to their creating release through drain and verification"
    ],
    "goal": "Select the smallest auditable architecture that permits economic modules and verifier backends to evolve without weakening global conservation, atomicity, replay safety, or no-bypass authority.",
    "obligations": [
      "derive every hard design gate from candidate structure",
      "separate advisory research ranking from evidence-backed selection",
      "retain minimized disaster histories for refuted alternatives",
      "require independent evidence for every gate and scenario before selection"
    ],
    "portals": ["deterministic checker", "stateful replay", "ESSO with Z3 and CVC5", "Lean", "Rust parity tests", "RISC0 substitution tests"],
    "metadata": ["maximum candidate width is bounded by review budget", "integer metrics use scale 0..1000", "metric weights sum to 10000 basis points", "ties use canonical candidate ID"]
  },
  "hard_gates": [
    {"id": "SOLE_DURABLE_WRITER", "description": "Every authoritative state domain persists only through ZenoLedger.", "minimum_evidence_grade": 3},
    {"id": "UNIQUE_STATE_OWNERSHIP", "description": "Every state domain has exactly one declared semantic owner.", "minimum_evidence_grade": 3},
    {"id": "TYPED_CLOSED_PORTS", "description": "All four required port roles use named closed request and response types without caller-created authority.", "minimum_evidence_grade": 3},
    {"id": "ACYCLIC_DEPENDENCIES", "description": "The component dependency graph is acyclic.", "minimum_evidence_grade": 3},
    {"id": "DETERMINISTIC_COMPOSITION_ORDER", "description": "Module and command order have one canonical rule and tie break.", "minimum_evidence_grade": 4},
    {"id": "ATOMIC_GLOBAL_RECONCILIATION", "description": "A centrally derived value delta and all effects publish with one expected-head compare-and-swap.", "minimum_evidence_grade": 4},
    {"id": "REJECT_NO_COMMIT", "description": "Every rejection leaves authoritative state and effects unchanged.", "minimum_evidence_grade": 4},
    {"id": "OPAQUE_VERIFIER_WITNESS", "description": "Only the selected verifier constructs a VerifiedAdmissionV2 authority witness.", "minimum_evidence_grade": 3},
    {"id": "VERIFIER_BACKEND_SUBSTITUTION", "description": "Tau and native verifiers implement one contract and disagreement rejects.", "minimum_evidence_grade": 3},
    {"id": "VERSION_COEXISTENCE_AND_DRAIN", "description": "Creating releases remain available for old objects through drain and verification lifecycles.", "minimum_evidence_grade": 3},
    {"id": "REPLAY_IDEMPOTENCY", "description": "Replay scope binds command, sender, nonce, writer epoch, and creating release.", "minimum_evidence_grade": 3},
    {"id": "NO_BYPASS_MOUNT", "description": "The only mounted writer capability is ZenoLedger submission.", "minimum_evidence_grade": 3},
    {"id": "DIRECT_ZRPF_CORE_PARITY", "description": "Direct and proof execution identify the same transition core.", "minimum_evidence_grade": 3}
  ],
  "soft_metrics": [
    {"id": "AUDITABILITY", "description": "Higher values indicate smaller and clearer authority and invariant surfaces.", "weight_bps": 2000},
    {"id": "CHANGE_ISOLATION", "description": "Higher values indicate fewer unrelated modules touched by one semantic upgrade.", "weight_bps": 1600},
    {"id": "GLOBAL_INVARIANT_LOCALITY", "description": "Higher values indicate direct global conservation and liability checking.", "weight_bps": 1800},
    {"id": "VERIFIER_REPLACEABILITY", "description": "Higher values indicate a narrow backend-neutral verifier contract.", "weight_bps": 1200},
    {"id": "MIGRATION_SAFETY", "description": "Higher values indicate explicit coexistence, pinning, drain, and retirement.", "weight_bps": 1200},
    {"id": "PROOF_REUSE", "description": "Higher values indicate one core and canonical observation across direct and ZRPF lanes.", "weight_bps": 1200},
    {"id": "OPERATIONAL_SIMPLICITY", "description": "Higher values indicate fewer distributed failure and recovery modes.", "weight_bps": 1000}
  ],
  "scenario_pack": [
    {"id": "TAU_UNAVAILABLE", "history": "Tau verifier becomes unavailable before admission while direct internal operation continues.", "expected_observation": "The selected fallback policy either obtains a native verified admission or rejects; Tau withdrawal stays pending and no settlement bypass occurs.", "minimum_evidence_grade": 3},
    {"id": "TAU_NATIVE_VERIFIER_MISMATCH", "history": "Tau and native verifier backends return different answers for the same canonical query.", "expected_observation": "Admission rejects with no state or effect change.", "minimum_evidence_grade": 3},
    {"id": "CROSS_MODULE_DOUBLE_ALLOCATION", "history": "A spot fee and proof reward both attempt to allocate the same protocol-owned source lot.", "expected_observation": "Central reconciliation detects duplicate lineage and rejects the entire candidate.", "minimum_evidence_grade": 4},
    {"id": "MIGRATION_DRAIN_WITH_OLD_OBJECTS", "history": "A new release activates while an auction and withdrawal created by the old release remain open.", "expected_observation": "New objects use the new release; old objects finish only through their pinned old release and terminal paths.", "minimum_evidence_grade": 3},
    {"id": "REJECTED_COMMAND_EXACT_NO_OP", "history": "One module proposes a valid delta and a later module rejects the command.", "expected_observation": "No proposed delta, history row, nullifier, proof record, or outbox effect commits.", "minimum_evidence_grade": 4},
    {"id": "REPLAY_ACROSS_RELEASE_EPOCH", "history": "A previously accepted command is resubmitted after writer-epoch and module-release rotation.", "expected_observation": "The replay scope rejects it without creating a second value movement.", "minimum_evidence_grade": 3},
    {"id": "ZRPF_RECEIPT_SUBSTITUTION", "history": "A valid proof receipt is paired with a different module registry or policy profile.", "expected_observation": "Exact journal and promotion-subject binding rejects before publication.", "minimum_evidence_grade": 3},
    {"id": "STALE_HEAD_CONCURRENT_PUBLICATION", "history": "Two valid composed candidates target one parent head.", "expected_observation": "At most one compare-and-swap commits; the loser receives a typed stale-head result.", "minimum_evidence_grade": 3},
    {"id": "OUTBOX_RETRY_AFTER_RESPONSE_LOSS", "history": "An external effect succeeds and the acknowledgment response is lost before retry.", "expected_observation": "The same committed outbox identity is redelivered idempotently and acknowledgment is a later core transition.", "minimum_evidence_grade": 3},
    {"id": "SHARED_ASSET_FEE_AND_REWARD_COLLISION", "history": "LP fees, oracle payment, validator reserve, and buyback each claim one revenue atom.", "expected_observation": "The obligations-first waterfall assigns the atom once or rejects an underfunded optional lane.", "minimum_evidence_grade": 4}
  ],
