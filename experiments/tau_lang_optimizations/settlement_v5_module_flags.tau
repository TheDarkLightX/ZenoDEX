# Experimental settlement v5, module-flag form
#
# Optimization idea:
# - keep only the cheap cross-module constraints inside Tau;
# - push expensive submodule arithmetic into separately checked host/module flags;
# - retain aligned anti-sandwich inputs instead of temporal lookback.
#
# Stream mapping:
# i1..i4 = order ids (canonical)
# i5 = price_prevprev
# i6 = price_prev
# i7 = price_curr
# i8 = cpmm_ok_host
# i9 = balance_ok_host
# i10 = token_ok_host
# i11 = buyback_ok_host
# i12 = rebate_ok_host
# i13 = lock_weight_ok_host
# o1 = canonical_ok
# o2 = no_sandwich_ok
# o3 = stable_ok
# o4 = settlement_ok

set charvar off

canonical(a : bv[16], b : bv[16], c : bv[16], d : bv[16]) := (a < b) && (b < c) && (c < d).
no_sandwich(pp : bv[16], p : bv[16], c : bv[16]) := ((pp <= p) && (p <= c)) || ((pp >= p) && (p >= c)).
stable(curr : bv[16], prev : bv[16]) := ((curr >= prev) && (curr - prev < { #x0032 }:bv[16])) || ((curr < prev) && (prev - curr < { #x0032 }:bv[16])).

always (
  (o1[t]:sbf = 1:sbf <-> canonical(i1[t]:bv[16], i2[t]:bv[16], i3[t]:bv[16], i4[t]:bv[16])) &&
  (o2[t]:sbf = 1:sbf <-> no_sandwich(i5[t]:bv[16], i6[t]:bv[16], i7[t]:bv[16])) &&
  (o3[t]:sbf = 1:sbf <-> stable(i7[t]:bv[16], i6[t]:bv[16])) &&
  (o4[t]:sbf = 1:sbf <-> (canonical(i1[t]:bv[16], i2[t]:bv[16], i3[t]:bv[16], i4[t]:bv[16]) && no_sandwich(i5[t]:bv[16], i6[t]:bv[16], i7[t]:bv[16]) && stable(i7[t]:bv[16], i6[t]:bv[16]) && (i8[t]:sbf = 1:sbf) && (i9[t]:sbf = 1:sbf) && (i10[t]:sbf = 1:sbf) && (i11[t]:sbf = 1:sbf) && (i12[t]:sbf = 1:sbf) && (i13[t]:sbf = 1:sbf)))
).
