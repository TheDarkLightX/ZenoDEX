# Experimental settlement admission envelope temporal v1
#
# Purpose:
# - extend the basic settlement admission envelope with node-progress and
#   governance/oracle guard fibers;
# - keep arithmetic, signatures, storage lookups, and receipt verification in
#   the host/verifier and pass Tau sbf flags;
# - expose diagnostic outputs so trace tests can distinguish local failure
#   causes from final admission failure.
#
# Stream mapping:
# i1  = action_swap (sbf)
# i2  = action_add_liquidity (sbf)
# i3  = action_remove_liquidity (sbf)
# i4  = action_cancel (sbf)
# i5  = sender_auth_ok (sbf)
# i6  = nonce_ok (sbf)
# i7  = expiry_ok (sbf)
# i8  = replay_not_seen_ok (sbf)
# i9  = pause_clear (sbf)
# i10 = oracle_fresh_ok (sbf)
# i11 = settlement_window_ok (sbf)
# i12 = route_ok (sbf)
# i13 = quote_receipt_ok (sbf)
# i14 = pool_snapshot_ok (sbf)
# i15 = max_hops_ok (sbf)
# i16 = slippage_ok (sbf)
# i17 = fee_cap_ok (sbf)
# i18 = amount_positive_ok (sbf)
# i19 = liquidity_sufficient_ok (sbf)
# i20 = risk_budget_ok (sbf)
# i21 = proof_ok (sbf)
# i22 = binding_ok (sbf)
# i23 = balance_ok (sbf)
# i24 = token_admitted_ok (sbf)
# i25 = previous_admission_state_ok (sbf)
# i26 = chain_height_monotone_ok (sbf)
# i27 = writer_epoch_ok (sbf)
# i28 = batch_capacity_ok (sbf)
# i29 = duplicate_pool_launch_clear (sbf)
# i30 = oracle_source_diverse_ok (sbf)
# i31 = signer_capability_ok (sbf)
# i32 = emergency_mode_allows_action (sbf)
#
# o1  = action_shape_ok
# o2  = identity_replay_ok
# o3  = time_oracle_ok
# o4  = route_quote_ok
# o5  = economic_bounds_ok
# o6  = proof_package_ok
# o7  = asset_state_ok
# o8  = node_progress_ok
# o9  = governance_oracle_ok
# o10 = settlement_admission_ok

set charvar off

on(x : sbf) := x = 1:sbf.
off(x : sbf) := x = 0:sbf.
one_hot_4(a : sbf, b : sbf, c : sbf, d : sbf) := (on(a) && off(b) && off(c) && off(d)) || (off(a) && on(b) && off(c) && off(d)) || (off(a) && off(b) && on(c) && off(d)) || (off(a) && off(b) && off(c) && on(d)).

always
  (o1[t]:sbf = 1:sbf <-> one_hot_4(i1[t]:sbf, i2[t]:sbf, i3[t]:sbf, i4[t]:sbf)) &&
  (o2[t]:sbf = i5[t]:sbf & i6[t]:sbf & i8[t]:sbf) &&
  (o3[t]:sbf = i7[t]:sbf & i10[t]:sbf & i11[t]:sbf) &&
  (o4[t]:sbf = i12[t]:sbf & i13[t]:sbf & i14[t]:sbf & i15[t]:sbf) &&
  (o5[t]:sbf = i16[t]:sbf & i17[t]:sbf & i18[t]:sbf & i19[t]:sbf & i20[t]:sbf) &&
  (o6[t]:sbf = i21[t]:sbf & i22[t]:sbf) &&
  (o7[t]:sbf = i23[t]:sbf & i24[t]:sbf) &&
  (o8[t]:sbf = i25[t]:sbf & i26[t]:sbf & i27[t]:sbf & i28[t]:sbf) &&
  (o9[t]:sbf = i29[t]:sbf & i30[t]:sbf & i31[t]:sbf & i32[t]:sbf) &&
  (o10[t]:sbf = i9[t]:sbf & o1[t]:sbf & o2[t]:sbf & o3[t]:sbf & o4[t]:sbf & o5[t]:sbf & o6[t]:sbf & o7[t]:sbf & o8[t]:sbf & o9[t]:sbf).
