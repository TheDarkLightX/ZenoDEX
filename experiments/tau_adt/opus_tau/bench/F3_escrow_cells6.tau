set charvar off
set maxsplits 1

type Esc = {a0: bv[8], a1: bv[8], a2: bv[8], a3: bv[8], a4: bv[8], a5: bv[8]}. n all e:Esc all f:Esc all d:bv[8] ((d <= e.a0 && e.a1 <= { #xff }:bv[8] - d && f.a0 = e.a0 - d && f.a1 = e.a1 + d && f.a2 = e.a2 && f.a3 = e.a3 && f.a4 = e.a4 && f.a5 = e.a5) -> (f.a0 <= e.a0 && f.a1 >= e.a1 && f.a0 + f.a1 + f.a2 + f.a3 + f.a4 + f.a5 = e.a0 + e.a1 + e.a2 + e.a3 + e.a4 + e.a5))
